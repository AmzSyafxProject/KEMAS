<Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Width="350" Height="350">
<Canvas Width="320" Height="320" ClipToBounds="True">
  <!-- soft breathing glow -->
  <Ellipse Width="300" Height="300" Canvas.Left="10" Canvas.Top="10">
    <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#557B5CFF" Offset="0"/><GradientStop Color="#007B5CFF" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
    <Ellipse.Triggers><EventTrigger RoutedEvent="FrameworkElement.Loaded"><BeginStoryboard><Storyboard RepeatBehavior="Forever" AutoReverse="True">
      <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.45" To="1" Duration="0:0:2.2"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
    </Storyboard></BeginStoryboard></EventTrigger></Ellipse.Triggers>
  </Ellipse>
  <!-- faint guide rings -->
  <Ellipse Width="240" Height="240" Canvas.Left="40" Canvas.Top="40" Stroke="#1AFFFFFF" StrokeThickness="1"/>
  <Ellipse Width="184" Height="184" Canvas.Left="68" Canvas.Top="68" Stroke="#14FFFFFF" StrokeThickness="1"/>
  <Ellipse Width="128" Height="128" Canvas.Left="96" Canvas.Top="96" Stroke="#10FFFFFF" StrokeThickness="1"/>
  <Canvas Width="320" Height="320" RenderTransformOrigin="0.5,0.5">
      <Canvas.RenderTransform><RotateTransform Angle="0"/></Canvas.RenderTransform>
      <Canvas.Triggers><EventTrigger RoutedEvent="FrameworkElement.Loaded"><BeginStoryboard><Storyboard RepeatBehavior="Forever">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:5.2"/>
      </Storyboard></BeginStoryboard></EventTrigger></Canvas.Triggers>
      <Path Data="M 160,40 A 120,120 0 1 1 40,160" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"><Path.Stroke><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#7B5CFF" Offset="0"/><GradientStop Color="#22D3F5" Offset="1"/></LinearGradientBrush></Path.Stroke></Path><Ellipse Canvas.Left="155" Canvas.Top="35" Width="10" Height="10" Fill="#FFFFFF" Opacity="1"/>
    </Canvas>
  <Canvas Width="320" Height="320" RenderTransformOrigin="0.5,0.5">
      <Canvas.RenderTransform><RotateTransform Angle="0"/></Canvas.RenderTransform>
      <Canvas.Triggers><EventTrigger RoutedEvent="FrameworkElement.Loaded"><BeginStoryboard><Storyboard RepeatBehavior="Forever">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="360" To="0" Duration="0:0:3.6"/>
      </Storyboard></BeginStoryboard></EventTrigger></Canvas.Triggers>
      <Path Data="M 160,68 A 92,92 0 1 1 68,160" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"><Path.Stroke><LinearGradientBrush StartPoint="0,1" EndPoint="1,0"><GradientStop Color="#22D3F5" Offset="0"/><GradientStop Color="#A99BFF" Offset="1"/></LinearGradientBrush></Path.Stroke></Path><Ellipse Canvas.Left="64" Canvas.Top="156" Width="8" Height="8" Fill="#FFFFFF" Opacity="1"/>
    </Canvas>
  <Canvas Width="320" Height="320" RenderTransformOrigin="0.5,0.5">
      <Canvas.RenderTransform><RotateTransform Angle="0"/></Canvas.RenderTransform>
      <Canvas.Triggers><EventTrigger RoutedEvent="FrameworkElement.Loaded"><BeginStoryboard><Storyboard RepeatBehavior="Forever">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:2.6"/>
      </Storyboard></BeginStoryboard></EventTrigger></Canvas.Triggers>
      <Path Data="M 160,96 A 64,64 0 1 1 96,160" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"><Path.Stroke><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#7B5CFF" Offset="0"/><GradientStop Color="#22D3F5" Offset="1"/></LinearGradientBrush></Path.Stroke></Path><Ellipse Canvas.Left="156.5" Canvas.Top="92.5" Width="7.0" Height="7.0" Fill="#FFFFFF" Opacity="1"/>
    </Canvas>
  <Canvas Width="320" Height="320" RenderTransformOrigin="0.5,0.5">
      <Canvas.RenderTransform><RotateTransform Angle="0"/></Canvas.RenderTransform>
      <Canvas.Triggers><EventTrigger RoutedEvent="FrameworkElement.Loaded"><BeginStoryboard><Storyboard RepeatBehavior="Forever">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:9"/>
      </Storyboard></BeginStoryboard></EventTrigger></Canvas.Triggers>
      <Ellipse Canvas.Left="157" Canvas.Top="49" Width="6" Height="6" Fill="#A99BFF" Opacity="0.9"/><Ellipse Canvas.Left="157" Canvas.Top="265" Width="6" Height="6" Fill="#22D3F5" Opacity="0.9"/><Ellipse Canvas.Left="49.5" Canvas.Top="157.5" Width="5.0" Height="5.0" Fill="#FFFFFF" Opacity="0.7"/>
    </Canvas>
  <Canvas Width="320" Height="320" RenderTransformOrigin="0.5,0.5">
      <Canvas.RenderTransform><RotateTransform Angle="0"/></Canvas.RenderTransform>
      <Canvas.Triggers><EventTrigger RoutedEvent="FrameworkElement.Loaded"><BeginStoryboard><Storyboard RepeatBehavior="Forever">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="360" To="0" Duration="0:0:7"/>
      </Storyboard></BeginStoryboard></EventTrigger></Canvas.Triggers>
      <Ellipse Canvas.Left="157.5" Canvas.Top="75.5" Width="5.0" Height="5.0" Fill="#22D3F5" Opacity="0.8"/><Ellipse Canvas.Left="157.5" Canvas.Top="239.5" Width="5.0" Height="5.0" Fill="#A99BFF" Opacity="0.8"/><Ellipse Canvas.Left="240" Canvas.Top="158" Width="4" Height="4" Fill="#FFFFFF" Opacity="0.6"/>
    </Canvas>
  <!-- core: breathing app badge -->
  <Canvas Width="320" Height="320" RenderTransformOrigin="0.5,0.5">
    <Canvas.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Canvas.RenderTransform>
    <Canvas.Triggers><EventTrigger RoutedEvent="FrameworkElement.Loaded"><BeginStoryboard><Storyboard RepeatBehavior="Forever" AutoReverse="True">
      <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.94" To="1.05" Duration="0:0:1.6"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
      <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.94" To="1.05" Duration="0:0:1.6"><DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
    </Storyboard></BeginStoryboard></EventTrigger></Canvas.Triggers>
    <Rectangle Canvas.Left="118" Canvas.Top="118" Width="84" Height="84" RadiusX="24" RadiusY="24"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#7B5CFF" Offset="0"/><GradientStop Color="#22D3F5" Offset="1"/></LinearGradientBrush></Rectangle.Fill>
      <Rectangle.Effect><DropShadowEffect Color="#7B5CFF" BlurRadius="28" ShadowDepth="0" Opacity="0.8"/></Rectangle.Effect></Rectangle>
    <Rectangle Canvas.Left="140" Canvas.Top="138" Width="10" Height="44" RadiusX="5" RadiusY="5" Fill="#FFFFFF"/>
    <Path Data="M 154,164 C 160,158 168,150 176,142" Stroke="#FFFFFF" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
    <Path Data="M 158,162 C 166,168 174,174 180,180" Stroke="#D0FFFFFF" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
    <Path Canvas.Left="178" Canvas.Top="124" Width="14" Height="14" Stretch="Fill" Fill="#FFFFFF" Data="M 8,0 Q 8,8 16,8 Q 8,8 8,16 Q 8,8 0,8 Q 8,8 8,0 Z"/>
  </Canvas>
</Canvas>
</Viewbox>
