                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,10">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <CheckBox Style="{StaticResource CB}" IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center" Tag="changed"/>
                          <StackPanel Grid.Column="1" Margin="4,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="{Binding Path}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                          </StackPanel>
                          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton Style="{StaticResource Pill}" GroupName="{Binding Group}" IsChecked="{Binding ByType, Mode=TwoWay}" Content="{DynamicResource L_by_type}"/>
                            <RadioButton Style="{StaticResource Pill}" GroupName="{Binding Group}" IsChecked="{Binding ByDate, Mode=TwoWay}" Content="{DynamicResource L_by_date}"/>
                            <Button Style="{StaticResource IconBtn}" Content="&#xE74D;" Tag="removefolder" ToolTip="{DynamicResource L_remove}" Margin="6,0,0,0"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="BtnAddFolder" Style="{StaticResource Ghost}">
                  <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="{DynamicResource L_add_folder}"/></StackPanel>
                </Button>
                <TextBlock Text="{DynamicResource L_date_format}" Style="{StaticResource Sub}" VerticalAlignment="Center" Margin="22,0,10,0"/>
                <RadioButton x:Name="DateFmt0" GroupName="datefmt" Style="{StaticResource Pill}" Content="2026\10 - October"/>
                <RadioButton x:Name="DateFmt1" GroupName="datefmt" Style="{StaticResource Pill}" Content="2026-10"/>
                <RadioButton x:Name="DateFmt2" GroupName="datefmt" Style="{StaticResource Pill}" Content="2026\October"/>
              </StackPanel>
            </Grid>

            <!-- rules -->
            <Grid x:Name="OrgRulesPanel" Grid.Row="2" Visibility="Collapsed">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid Margin="16,0,60,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource L_rule_folder}" Style="{StaticResource Label}"/>
                <TextBlock Grid.Column="1" Text="{DynamicResource L_rule_types}" Style="{StaticResource Label}" Margin="12,0,0,0"/>
              </Grid>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="OrgRuleList" Margin="0,0,10,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,8">
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=500}" FontWeight="SemiBold"/>
                          <TextBox Grid.Column="1" Margin="12,0,0,0" Text="{Binding Extensions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=500}"/>
                          <Button Grid.Column="2" Style="{StaticResource IconBtn}" Content="&#xE74D;" Tag="removerule" ToolTip="{DynamicResource L_remove}" Margin="8,0,0,0"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <Grid Grid.Row="2" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="BtnAddRule" Style="{StaticResource Ghost}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="{DynamicResource L_add_rule}"/></StackPanel>
                  </Button>
                  <TextBlock Text="{DynamicResource L_others_name}" Style="{StaticResource Sub}" VerticalAlignment="Center" Margin="18,0,10,0"/>
                  <TextBox x:Name="OthersName" Width="150"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button x:Name="BtnImport" Style="{StaticResource Ghost}" Content="{DynamicResource L_import}"/>
                  <Button x:Name="BtnExport" Style="{StaticResource Ghost}" Content="{DynamicResource L_export}" Margin="8,0,0,0"/>
                  <Button x:Name="BtnResetRules" Style="{StaticResource Ghost}" Content="{DynamicResource L_reset}" Margin="8,0,0,0"/>
                </StackPanel>
              </Grid>
            </Grid>

            <!-- preview -->
            <Grid x:Name="OrgPreviewPanel" Grid.Row="2" Visibility="Collapsed">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <TextBlock x:Name="OrgSummary" Style="{StaticResource Sub}" Margin="2,0,0,10" Text="{DynamicResource L_org_hint}"/>
              <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6">
                <DataGrid x:Name="OrgGrid" SelectionMode="Extended">
                  <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding File}" Width="2*"/>
                    <DataGridTextColumn Binding="{Binding Folder}" Width="110"/>
                    <DataGridTextColumn Binding="{Binding Destination}" Width="1.6*"/>
                    <DataGridTextColumn Binding="{Binding Size}" SortMemberPath="Bytes" Width="100"/>
                  </DataGrid.Columns>
                </DataGrid>
              </Border>
            </Grid>
          </Grid>

          <!-- ================= MEMORY ================= -->
          <Grid x:Name="PageRam" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,20">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,16,0">
                <TextBlock Text="{DynamicResource L_ram_title}" Style="{StaticResource H1}"/>
                <TextBlock Text="{DynamicResource L_ram_sub}" Style="{StaticResource Sub}"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="BtnRamRefresh" Content="{DynamicResource L_refresh}" Style="{StaticResource Ghost}"/>
                <Button x:Name="BtnTrim" Content="{DynamicResource L_free_ram}" Style="{StaticResource Primary}" Margin="10,0,0,0"/>
                <Button x:Name="BtnKill" Content="{DynamicResource L_end_selected}" Style="{StaticResource Danger}" Margin="10,0,0,0"/>
              </StackPanel>
            </Grid>
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <Grid>
                  <TextBlock x:Name="RamPageText" Text="-" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                  <TextBlock x:Name="RamPagePct" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource CyanBrush}" HorizontalAlignment="Right"/>
                </Grid>
                <ProgressBar x:Name="RamPageBar" Height="12" Margin="0,12,0,0"/>
              </StackPanel>
            </Border>
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6">
              <DataGrid x:Name="ProcGrid" SelectionMode="Extended">
                <DataGrid.Columns>
                  <DataGridTextColumn Binding="{Binding App}" Width="1.3*"/>
                  <DataGridTextColumn Binding="{Binding RAM}" SortMemberPath="RamMB" Width="110"/>
                  <DataGridTextColumn Binding="{Binding Procs}" Width="95"/>
                  <DataGridTextColumn Binding="{Binding Description}" Width="2*"/>
                  <DataGridTextColumn Binding="{Binding Status}" Width="110"/>
                </DataGrid.Columns>
              </DataGrid>
            </Border>
            <TextBlock Grid.Row="3" Style="{StaticResource Sub}" Margin="2,10,0,0" Text="{DynamicResource L_ram_tip}"/>
          </Grid>

          <!-- ================= STARTUP APPS ================= -->
          <Grid x:Name="PageStartup" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,20">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,16,0">
                <TextBlock Text="{DynamicResource L_startup_title}" Style="{StaticResource H1}"/>
                <TextBlock Text="{DynamicResource L_startup_sub}" Style="{StaticResource Sub}"/>
              </StackPanel>
              <Button Grid.Column="1" x:Name="BtnStartupRefresh" Content="{DynamicResource L_refresh}" Style="{StaticResource Ghost}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18,4,18,4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl x:Name="StartupList" Margin="0,0,6,0" VirtualizingPanel.IsVirtualizing="True">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Padding="0,11" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource IconTile}">
                          <TextBlock Style="{StaticResource Icon}" Text="&#xE7E8;" FontSize="14" Foreground="{StaticResource CyanBrush}" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                            <Border CornerRadius="9" Padding="8,1" Margin="10,0,0,0" Background="{Binding ImpactBg}" VerticalAlignment="Center" ToolTip="{DynamicResource L_impact_tip}">
                              <TextBlock Text="{Binding ImpactText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding ImpactBrush}"/>
                            </Border>
                          </StackPanel>
                          <TextBlock FontSize="12" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Command}">
                            <Run Text="{Binding Location, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Command, Mode=OneWay}"/>
                          </TextBlock>
                        </StackPanel>
                        <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding Enabled, Mode=OneWay}" Tag="startup"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            </Border>
            <TextBlock x:Name="StartupSummary" Grid.Row="2" Style="{StaticResource Sub}" Margin="2,10,0,0"/>
          </Grid>

          <!-- ================= PROGRAMS ================= -->
          <Grid x:Name="PageApps" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,20">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,16,0">
                <TextBlock Text="{DynamicResource L_apps_title}" Style="{StaticResource H1}"/>
                <TextBlock Text="{DynamicResource L_apps_sub}" Style="{StaticResource Sub}"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Grid Width="220">
                  <TextBox x:Name="AppSearch"/>
                  <TextBlock x:Name="AppSearchHint" Text="{DynamicResource L_search}" Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
                <Button x:Name="BtnAppsRefresh" Content="{DynamicResource L_refresh}" Style="{StaticResource Ghost}" Margin="10,0,0,0"/>
                <Button x:Name="BtnUninstall" Content="{DynamicResource L_uninstall}" Style="{StaticResource Danger}" Margin="10,0,0,0"/>
              </StackPanel>
            </Grid>
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6">
              <DataGrid x:Name="AppGrid" SelectionMode="Single">
                <DataGrid.Columns>
                  <DataGridTextColumn Binding="{Binding Name}" Width="2*"/>
                  <DataGridTextColumn Binding="{Binding Publisher}" Width="1.3*"/>
                  <DataGridTextColumn Binding="{Binding Size}" SortMemberPath="SizeMB" Width="100"/>
                  <DataGridTextColumn Binding="{Binding Version}" Width="110"/>
                  <DataGridTextColumn Binding="{Binding Installed}" SortMemberPath="InstallSort" Width="110"/>
                </DataGrid.Columns>
              </DataGrid>
            </Border>
            <TextBlock x:Name="AppSummary" Grid.Row="2" Style="{StaticResource Sub}" Margin="2,10,0,0"/>
          </Grid>

          <!-- ================= SETTINGS ================= -->
          <Grid x:Name="PageSettings" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,18">
              <TextBlock Text="{DynamicResource L_settings_title}" Style="{StaticResource H1}"/>
              <TextBlock Text="{DynamicResource L_settings_sub}" Style="{StaticResource Sub}"/>
            </StackPanel>
            <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="10" VerticalAlignment="Top">
              <StackPanel>
                <RadioButton x:Name="SetCatApp" Style="{StaticResource Nav}" GroupName="setcat" Tag="&#xE790;" Content="{DynamicResource L_set_appearance}" IsChecked="True"/>
                <RadioButton x:Name="SetCatGen" Style="{StaticResource Nav}" GroupName="setcat" Tag="&#xE713;" Content="{DynamicResource L_set_general}"/>
                <RadioButton x:Name="SetCatClean" Style="{StaticResource Nav}" GroupName="setcat" Tag="&#xE74D;" Content="{DynamicResource L_set_cleaning}"/>
                <RadioButton x:Name="SetCatUpd" Style="{StaticResource Nav}" GroupName="setcat" Tag="&#xE895;" Content="{DynamicResource L_set_updates}"/>
                <RadioButton x:Name="SetCatHelp" Style="{StaticResource Nav}" GroupName="setcat" Tag="&#xE897;" Content="{DynamicResource L_help_title}"/>
                <RadioButton x:Name="SetCatData" Style="{StaticResource Nav}" GroupName="setcat" Tag="&#xE8B7;" Content="{DynamicResource L_set_data}"/>
              </StackPanel>
            </Border>
            <ScrollViewer x:Name="SetScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="0,0,10,10">
                <TextBlock x:Name="SecApp" Text="{DynamicResource L_set_appearance}" Style="{StaticResource Label}" Margin="4,0,0,8"/>
                <Border Style="{StaticResource Card}" Padding="20,6" Margin="0,0,0,18">
                  <StackPanel>
                    <Grid Margin="0,10">
                      <StackPanel Margin="0,0,330,0"><TextBlock Text="{DynamicResource L_set_theme}" Style="{StaticResource H2}"/><TextBlock Text="{DynamicResource L_set_theme_d}" Style="{StaticResource Sub}"/></StackPanel>
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <RadioButton x:Name="ThemeDark" GroupName="theme" Style="{StaticResource Pill}" Content="{DynamicResource L_dark}"/>
                        <RadioButton x:Name="ThemeLight" GroupName="theme" Style="{StaticResource Pill}" Content="{DynamicResource L_light}"/>
                        <RadioButton x:Name="ThemeSystem" GroupName="theme" Style="{StaticResource Pill}" Content="{DynamicResource L_system}" Margin="0"/>
                      </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource LineBrush}"/>
                    <Grid Margin="0,10">
                      <StackPanel Margin="0,0,330,0"><TextBlock Text="{DynamicResource L_set_lang}" Style="{StaticResource H2}"/><TextBlock Text="{DynamicResource L_set_lang_d}" Style="{StaticResource Sub}"/></StackPanel>
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <RadioButton x:Name="LangEn" GroupName="lang" Style="{StaticResource Pill}" Content="English"/>
                        <RadioButton x:Name="LangMs" GroupName="lang" Style="{StaticResource Pill}" Content="Bahasa Melayu" Margin="0"/>
                      </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource LineBrush}"/>
                    <Grid Margin="0,10">
                      <StackPanel Margin="0,0,100,0"><TextBlock Text="{DynamicResource L_set_motion}" Style="{StaticResource H2}"/><TextBlock x:Name="MotionDesc" Style="{StaticResource Sub}"/></StackPanel>
                      <CheckBox x:Name="SetMotion" Style="{StaticResource Switch}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource LineBrush}"/>
                    <Grid Margin="0,10">
                      <StackPanel Margin="0,0,330,0"><TextBlock Text="{DynamicResource L_set_name}" Style="{StaticResource H2}"/><TextBlock Text="{DynamicResource L_set_name_d}" Style="{StaticResource Sub}"/></StackPanel>
                      <Grid Width="240" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBox x:Name="SetName"/>
                        <TextBlock x:Name="SetNameHint" Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                      </Grid>
                    </Grid>
                  </StackPanel>
                </Border>

                <TextBlock x:Name="SecGen" Text="{DynamicResource L_set_general}" Style="{StaticResource Label}" Margin="4,0,0,8"/>
                <Border Style="{StaticResource Card}" Padding="20,6" Margin="0,0,0,18">
                  <StackPanel>
                    <Grid Margin="0,10">
                      <StackPanel Margin="0,0,100,0"><TextBlock Text="{DynamicResource L_set_startup}" Style="{StaticResource H2}"/><TextBlock Text="{DynamicResource L_set_startup_d}" Style="{StaticResource Sub}"/></StackPanel>
                      <CheckBox x:Name="SetStartup" Style="{StaticResource Switch}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource LineBrush}"/>
                    <Grid Margin="0,10">
                      <StackPanel Margin="0,0,100,0"><TextBlock Text="{DynamicResource L_set_tray}" Style="{StaticResource H2}"/><TextBlock Text="{DynamicResource L_set_tray_d}" Style="{StaticResource Sub}"/></StackPanel>
                      <CheckBox x:Name="SetTray" Style="{StaticResource Switch}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource LineBrush}"/>
                    <Grid Margin="0,10">
                      <StackPanel Margin="0,0,100,0"><TextBlock Text="{DynamicResource L_set_scanstart}" Style="{StaticResource H2}"/><TextBlock Text="{DynamicResource L_set_scanstart_d}" Style="{StaticResource Sub}"/></StackPanel>
                      <CheckBox x:Name="SetScanStart" Style="{StaticResource Switch}" HorizontalAlignment="Right"/>
                    </Grid>
                  </StackPanel>
                </Border>

                <TextBlock x:Name="SecClean" Text="{DynamicResource L_set_cleaning}" Style="{StaticResource Label}" Margin="4,0,0,8"/>
                <Border Style="{StaticResource Card}" Padding="20,6" Margin="0,0,0,18">
                  <StackPanel>
                    <Grid Margin="0,10">
                      <StackPanel Margin="0,0,330,0"><TextBlock Text="{DynamicResource L_set_auto}" Style="{StaticResource H2}"/><TextBlock Text="{DynamicResource L_set_auto_d}" Style="{StaticResource Sub}"/></StackPanel>
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <RadioButton x:Name="AutoOff" GroupName="auto" Style="{StaticResource Pill}" Content="{DynamicResource L_off}"/>
                        <RadioButton x:Name="AutoDaily" GroupName="auto" Style="{StaticResource Pill}" Content="{DynamicResource L_daily}"/>
                        <RadioButton x:Name="AutoWeekly" GroupName="auto" Style="{StaticResource Pill}" Content="{DynamicResource L_weekly}" Margin="0"/>
                      </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource LineBrush}"/>
                    <Grid Margin="0,10">
                      <StackPanel Margin="0,0,100,0"><TextBlock Text="{DynamicResource L_set_confirm}" Style="{StaticResource H2}"/><TextBlock Text="{DynamicResource L_set_confirm_d}" Style="{StaticResource Sub}"/></StackPanel>
                      <CheckBox x:Name="SetConfirm" Style="{StaticResource Switch}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource LineBrush}"/>
                    <Grid Margin="0,10">
                      <StackPanel Margin="0,0,100,0"><TextBlock Text="{DynamicResource L_set_recent}" Style="{StaticResource H2}"/><TextBlock Text="{DynamicResource L_set_recent_d}" Style="{StaticResource Sub}"/></StackPanel>
                      <CheckBox x:Name="SetRecent" Style="{StaticResource Switch}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource LineBrush}"/>
                    <Grid Margin="0,10">
                      <StackPanel Margin="0,0,100,0"><TextBlock Text="{DynamicResource L_set_restartdel}" Style="{StaticResource H2}"/><TextBlock Text="{DynamicResource L_set_restartdel_d}" Style="{StaticResource Sub}"/></StackPanel>
                      <CheckBox x:Name="SetRestartDel" Style="{StaticResource Switch}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource LineBrush}"/>
                    <Grid Margin="0,10">
                      <StackPanel Margin="0,0,100,0"><TextBlock Text="{DynamicResource L_set_smartram}" Style="{StaticResource H2}"/><TextBlock Text="{DynamicResource L_set_smartram_d}" Style="{StaticResource Sub}"/></StackPanel>
                      <CheckBox x:Name="SetSmartRam" Style="{StaticResource Switch}" HorizontalAlignment="Right"/>
                    </Grid>
                  </StackPanel>
                </Border>

                <TextBlock x:Name="SecUpd" Text="{DynamicResource L_set_updates}" Style="{StaticResource Label}" Margin="4,0,0,8"/>
                <Border Style="{StaticResource Card}" Padding="20,6" Margin="0,0,0,18">
                  <StackPanel>
                    <Grid x:Name="AutoUpdateRow" Margin="0,10">
                      <StackPanel Margin="0,0,100,0"><TextBlock Text="{DynamicResource L_set_autoupdate}" Style="{StaticResource H2}"/><TextBlock Text="{DynamicResource L_set_autoupdate_d}" Style="{StaticResource Sub}"/></StackPanel>
                      <CheckBox x:Name="SetAutoUpdate" Style="{StaticResource Switch}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Border x:Name="AutoUpdateLine" Height="1" Background="{DynamicResource LineBrush}"/>
                    <Grid Margin="0,10">
                      <StackPanel Margin="0,0,200,0"><TextBlock x:Name="VersionLine" Style="{StaticResource H2}"/><TextBlock x:Name="UpdateStatus" Style="{StaticResource Sub}"/></StackPanel>
                      <Button x:Name="BtnCheckUpdate" Style="{StaticResource Ghost}" Content="{DynamicResource L_check_now}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Border x:Name="InstallRowLine" Height="1" Background="{DynamicResource LineBrush}"/>
                    <Grid x:Name="InstallRow" Margin="0,10">
                      <StackPanel Margin="0,0,200,0"><TextBlock x:Name="InstallTitle" Style="{StaticResource H2}"/><TextBlock x:Name="InstallDesc" Style="{StaticResource Sub}"/></StackPanel>
                      <Button x:Name="BtnInstall" Style="{StaticResource Ghost}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                  </StackPanel>
                </Border>

                <TextBlock x:Name="SecHelp" Text="{DynamicResource L_help_title}" Style="{StaticResource Label}" Margin="4,0,0,8"/>
                <Border Style="{StaticResource Card}" Padding="20,6" Margin="0,0,0,18">
                  <Grid Margin="0,10">
                    <StackPanel Margin="0,0,200,0"><TextBlock Text="{DynamicResource L_help_card}" Style="{StaticResource H2}"/><TextBlock Text="{DynamicResource L_help_card_d}" Style="{StaticResource Sub}"/></StackPanel>
                    <Button x:Name="BtnReport" Style="{StaticResource Primary}" Content="{DynamicResource L_help_report}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                  </Grid>
                </Border>

                <TextBlock x:Name="SecData" Text="{DynamicResource L_set_data}" Style="{StaticResource Label}" Margin="4,0,0,8"/>
                <Border Style="{StaticResource Card}" Padding="20,14">
                  <WrapPanel>
                    <Button x:Name="BtnDataFolder" Content="{DynamicResource L_open_data}" Style="{StaticResource Ghost}" Margin="0,0,10,0"/>
                    <Button x:Name="BtnErrLog" Content="{DynamicResource L_error_log}" Style="{StaticResource Ghost}" Margin="0,0,10,0"/>
                    <Button x:Name="BtnResetSettings" Content="{DynamicResource L_reset_settings}" Style="{StaticResource Danger}"/>
                  </WrapPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
            </Grid>
          </Grid>

          <!-- ================= PC DOCTOR ================= -->
          <Grid x:Name="PageDoctor" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,18">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,16,0">
                <TextBlock Text="{DynamicResource L_doc_title}" Style="{StaticResource H1}"/>
                <TextBlock Text="{DynamicResource L_doc_sub}" Style="{StaticResource Sub}"/>
              </StackPanel>
              <Button Grid.Column="1" x:Name="BtnDocCheck" Style="{StaticResource Primary}" HorizontalAlignment="Right" VerticalAlignment="Center" Content="{DynamicResource L_doc_check}"/>
            </Grid>
            <Grid Grid.Row="1">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}" Padding="22,10">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="DocList"/></ScrollViewer>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top" Padding="22,20">
                <StackPanel>
                  <TextBlock Text="{DynamicResource L_doc_how}" Style="{StaticResource Label}"/>
                  <TextBlock Text="{DynamicResource L_doc_how_d}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,16" LineHeight="19"/>
                  <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,0,0,14"/>
                  <TextBlock Text="{DynamicResource L_doc_result}" Style="{StaticResource Label}"/>
                  <TextBlock x:Name="DocCount" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,6,0,0"/>
                  <TextBlock x:Name="DocCountSub" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </Grid>
          </Grid>

          <!-- ================= STORAGE MAP ================= -->
          <Grid x:Name="PageMap" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,18">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,16,0">
                <TextBlock Text="{DynamicResource L_map_title}" Style="{StaticResource H1}"/>
                <TextBlock x:Name="MapSub" Text="{DynamicResource L_map_sub}" Style="{StaticResource Sub}"/>
              </StackPanel>
              <Button Grid.Column="1" x:Name="BtnMapScan" Style="{StaticResource Primary}" HorizontalAlignment="Right" VerticalAlignment="Center" Content="{DynamicResource L_map_scan}"/>
            </Grid>
            <Grid Grid.Row="1">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}" Padding="12">
                <Grid>
                  <Canvas x:Name="MapCanvas" ClipToBounds="True"/>
                  <TextBlock x:Name="MapHint" Text="{DynamicResource L_map_hint}" FontSize="13" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="30"/>
                </Grid>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22,18">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="{DynamicResource L_map_hist}" Style="{StaticResource Label}"/>
                    <Canvas Width="256" Height="70" Margin="0,10,0,4" HorizontalAlignment="Left"><Polyline x:Name="MapHistLine" Stroke="{StaticResource CyanBrush}" StrokeThickness="2" StrokeLineJoin="Round"/></Canvas>
                    <TextBlock x:Name="MapHistText" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                    <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,14,0,12"/>
                    <TextBlock Text="{DynamicResource L_map_big}" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                  </StackPanel>
                  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="MapBigList"/></ScrollViewer>
                </DockPanel>
              </Border>
            </Grid>
          </Grid>

          <!-- ================= RECOVERY CENTRE ================= -->
          <Grid x:Name="PageRecover" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,18">
              <TextBlock Text="{DynamicResource L_rec_title}" Style="{StaticResource H1}"/>
              <TextBlock Text="{DynamicResource L_rec_sub}" Style="{StaticResource Sub}"/>
            </StackPanel>
            <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,16">
              <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><Border Width="38" Height="38" CornerRadius="10" Background="#2227B77A"><TextBlock Style="{StaticResource Icon}" Text="&#xE7A7;" FontSize="16" Foreground="#27B77A" HorizontalAlignment="Center"/></Border><StackPanel Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="{DynamicResource L_rec_c1}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/><TextBlock Text="{DynamicResource L_rec_c1d}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/></StackPanel></StackPanel></Border>
              <Border Style="{StaticResource Card}" Padding="18,16" Margin="8,0,8,0"><StackPanel Orientation="Horizontal"><Border Width="38" Height="38" CornerRadius="10" Background="#1F3978F6"><TextBlock Style="{StaticResource Icon}" Text="&#xE7E8;" FontSize="16" Foreground="#3978F6" HorizontalAlignment="Center"/></Border><StackPanel Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="{DynamicResource L_rec_c2}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/><TextBlock Text="{DynamicResource L_rec_c2d}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/></StackPanel></StackPanel></Border>
              <Border Style="{StaticResource Card}" Padding="18,16" Margin="8,0,0,0"><StackPanel Orientation="Horizontal"><Border Width="38" Height="38" CornerRadius="10" Background="#1F8B78F6"><TextBlock Style="{StaticResource Icon}" Text="&#xE9F9;" FontSize="16" Foreground="#8B78F6" HorizontalAlignment="Center"/></Border><StackPanel Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="{DynamicResource L_rec_c3}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/><TextBlock Text="{DynamicResource L_rec_c3d}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/></StackPanel></StackPanel></Border>
            </UniformGrid>
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="22,8,22,8">
              <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{DynamicResource L_rec_local}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,4"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel>
                    <TextBlock x:Name="RecEmpty" Text="{DynamicResource L_rec_empty}" FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,14,0,14" TextWrapping="Wrap"/>
                    <StackPanel x:Name="RecList"/>
                  </StackPanel>
                </ScrollViewer>
              </DockPanel>
            </Border>
          </Grid>

          <!-- ================= ABOUT ================= -->
          <ScrollViewer x:Name="PageAbout" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,10">
              <Border CornerRadius="26" Padding="40,36" Background="{DynamicResource HeroBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Margin="0,0,0,16">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Image x:Name="AboutLogo" Width="120" Height="120" RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform><TranslateTransform/></Image.RenderTransform>
                  </Image>
                  <StackPanel Grid.Column="1" Margin="32,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="KEMAS" FontSize="52" FontWeight="Black" Foreground="{DynamicResource HeroText}"/>
                    <TextBlock Text="{DynamicResource L_tagline}" FontSize="17" Foreground="{DynamicResource HeroMuted}" Margin="0,-4,0,0"/>
                    <TextBlock x:Name="AboutVersion" FontSize="12.5" Foreground="{DynamicResource HeroMuted}" Margin="0,14,0,0"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <Button x:Name="BtnAboutUpdate" Style="{StaticResource Ghost}" Content="{DynamicResource L_check_now}"/>
                  </StackPanel>
                </Grid>
              </Border>

              <Border Style="{StaticResource Card}" Padding="36,32" Margin="0,0,0,16">
                <StackPanel>
                  <TextBlock Text="{DynamicResource L_credits}" Style="{StaticResource Label}"/>
                  <TextBlock Text="{DynamicResource L_cr_headline}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,14,0,0"/>
                  <TextBlock Text="{DynamicResource L_cr_story1}" FontSize="14" LineHeight="23" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,14,0,0"/>
                  <TextBlock Text="{DynamicResource L_cr_story2}" FontSize="14" LineHeight="23" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                  <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,26,0,22"/>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{DynamicResource L_cr_created}" Style="{StaticResource Label}"/>
                      <TextBlock Text="Amzar Syafiq" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,8,0,0"/>
                      <TextBlock Text="{DynamicResource L_cr_role}" FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                      <TextBlock Text="Ceritareka Studio" FontSize="13" Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="{DynamicResource L_cr_ack}" Style="{StaticResource Label}"/>
                      <TextBlock Text="{DynamicResource L_cr_ack_text}" FontSize="13" LineHeight="21" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>

              <Border CornerRadius="18" Padding="36,28" Margin="0,0,0,16" Background="{DynamicResource HeroBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                <StackPanel>
                  <TextBlock Text="{DynamicResource L_cr_thanks_title}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource HeroText}"/>
                  <TextBlock Text="{DynamicResource L_cr_thanks}" FontSize="14" LineHeight="23" Foreground="{DynamicResource HeroMuted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                  <TextBlock Text="— Amzar Syafiq" FontSize="14" FontStyle="Italic" Foreground="{DynamicResource HeroText}" Margin="0,14,0,0"/>
                </StackPanel>
              </Border>

              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="20" Foreground="{StaticResource CyanBrush}" HorizontalAlignment="Left"/>
                    <TextBlock Text="{DynamicResource L_ab_privacy}" Style="{StaticResource H2}" Margin="0,12,0,0"/>
                    <TextBlock Text="{DynamicResource L_ab_privacy_d}" Style="{StaticResource Sub}"/>
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7A7;" FontSize="20" Foreground="{StaticResource CyanBrush}" HorizontalAlignment="Left"/>
                    <TextBlock Text="{DynamicResource L_ab_safe}" Style="{StaticResource H2}" Margin="0,12,0,0"/>
                    <TextBlock Text="{DynamicResource L_ab_safe_d}" Style="{StaticResource Sub}"/>
                  </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="20" Foreground="{StaticResource CyanBrush}" HorizontalAlignment="Left"/>
                    <TextBlock Text="{DynamicResource L_ab_light}" Style="{StaticResource H2}" Margin="0,12,0,0"/>
                    <TextBlock Text="{DynamicResource L_ab_light_d}" Style="{StaticResource Sub}"/>
                  </StackPanel>
                </Border>
              </Grid>
              <Border Style="{StaticResource Card}" Padding="28,22" Margin="0,16,0,0">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Width="46" Height="46" CornerRadius="14" Background="{DynamicResource IconTile}" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE897;" FontSize="19" Foreground="{StaticResource CyanBrush}" HorizontalAlignment="Center"/>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="18,0,18,0" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource L_help_card}" Style="{StaticResource H2}"/>
                    <TextBlock Text="{DynamicResource L_help_card_d}" Style="{StaticResource Sub}"/>
                  </StackPanel>
                  <Button x:Name="BtnAboutReport" Grid.Column="2" Style="{StaticResource Primary}" Content="{DynamicResource L_help_report}" VerticalAlignment="Center"/>
                </Grid>
              </Border>
              <Border Style="{StaticResource Card}" Padding="28,22" Margin="0,16,0,0">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource L_sup_title}" Style="{StaticResource H2}"/>
                    <TextBlock Text="{DynamicResource L_sup_desc}" Style="{StaticResource Sub}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnSup5" Style="{StaticResource Ghost}" Content="RM5" Margin="0,0,10,0"/>
                    <Button x:Name="BtnSup10" Style="{StaticResource Ghost}" Content="RM10" Margin="0,0,10,0"/>
                    <Button x:Name="BtnSup15" Style="{StaticResource Primary}" Content="RM15"/>
                  </StackPanel>
                </Grid>
              </Border>
              <TextBlock x:Name="CopyrightText" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,22,0,6"/>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="34,0">
          <Grid>
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,260,0"/>
            <ProgressBar x:Name="MainProgress" Width="220" Height="5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- ===== toast ===== -->
    <Border x:Name="Toast" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="236,0,0,58" CornerRadius="14"
            Background="{DynamicResource DialogBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="18,11">
      <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
      <StackPanel Orientation="Horizontal">
        <TextBlock x:Name="ToastIcon" Style="{StaticResource Icon}" Text="&#xE946;" Foreground="{StaticResource CyanBrush}" FontSize="14"/>
        <TextBlock x:Name="ToastText" Margin="10,0,0,0" FontSize="13" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>

    <!-- ===== maintenance overlay ===== -->
    <Grid x:Name="Overlay" Visibility="Collapsed" Background="{DynamicResource OverlayBrush}">
      <Border x:Name="OverlayCard" Width="880" Height="500" CornerRadius="26" Background="{DynamicResource DialogBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="30" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid x:Name="Stage" Width="350" Height="350" VerticalAlignment="Center">
            <Border CornerRadius="24" Background="#0D1020" BorderBrush="#1FFFFFFF" BorderThickness="1"/>
            <ContentControl x:Name="SceneHost"/>
          </Grid>

          <Grid x:Name="WorkView" Grid.Column="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel>
              <TextBlock x:Name="OvTitle" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
              <TextBlock x:Name="OvSub" Style="{StaticResource Sub}"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="0,18,0,14">
              <Grid>
                <TextBlock x:Name="OvPct" Text="0%" FontSize="40" FontWeight="Bold" Foreground="{StaticResource AccentGrad}"/>
                <TextBlock x:Name="OvStep" Foreground="{DynamicResource MutedBrush}" FontSize="12.5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="120,0,0,10" TextTrimming="CharacterEllipsis"/>
              </Grid>
              <ProgressBar x:Name="OvBar" Height="10" Margin="0,6,0,0"/>
            </StackPanel>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="OvList" Margin="0,0,6,0"/>
            </ScrollViewer>
            <Button x:Name="BtnStop" Grid.Row="3" Content="{DynamicResource L_stop}" Style="{StaticResource Ghost}" HorizontalAlignment="Right" Margin="0,12,0,0" Padding="26,0"/>
          </Grid>

          <Grid x:Name="DoneView" Grid.Column="2" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
              <Canvas Width="72" Height="72">
                <Ellipse x:Name="DoneCircle" Width="64" Height="64" Canvas.Left="4" Canvas.Top="4" Stroke="{StaticResource GoodBrush}" StrokeThickness="4" StrokeDashArray="51 51" StrokeDashOffset="51"/>
                <Path x:Name="DoneCheck" Data="M 22,37 L 32,47 L 52,27" Stroke="{StaticResource GoodBrush}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeDashArray="9 9" StrokeDashOffset="9"/>
              </Canvas>
              <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="DoneTitle" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock x:Name="DoneSub" Style="{StaticResource Sub}"/>
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="0,18,0,12">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="DoneBig" Text="0 B" FontSize="44" FontWeight="Bold" Foreground="{StaticResource AccentGrad}"/>
                <TextBlock x:Name="DoneBigSub" FontSize="15" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Bottom" Margin="10,0,0,10"/>
              </StackPanel>
              <WrapPanel x:Name="DoneChips" Margin="0,8,0,0"/>
            </StackPanel>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="DoneNotes" Margin="0,0,6,0"/>
            </ScrollViewer>
            <Button x:Name="BtnFinish" Grid.Row="3" Style="{StaticResource Primary}" HorizontalAlignment="Right" Margin="0,12,0,0" Padding="34,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="13" Margin="0,0,10,0"/>
                <TextBlock Text="{DynamicResource L_finish}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <!-- ===== dialog ===== -->
    <Grid x:Name="DialogLayer" Visibility="Collapsed" Background="{DynamicResource OverlayBrush}">
      <Border x:Name="DialogCard" Width="500" CornerRadius="22" Background="{DynamicResource DialogBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="28,26"
              VerticalAlignment="Center" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
        <StackPanel>
          <Border x:Name="DialogBadge" Width="50" Height="50" CornerRadius="15" Background="{StaticResource AccentGrad}" HorizontalAlignment="Left">
            <TextBlock x:Name="DialogIcon" Style="{StaticResource Icon}" Text="&#xE946;" FontSize="20" Foreground="White" HorizontalAlignment="Center"/>
          </Border>
          <TextBlock x:Name="DialogTitle" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,16,0,0" TextWrapping="Wrap"/>
          <TextBlock x:Name="DialogMsg" FontSize="13.5" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
          <CheckBox x:Name="DialogCheck" Style="{StaticResource CB}" Margin="0,16,0,0" Visibility="Collapsed"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button x:Name="BtnDialogNo" Content="{DynamicResource L_cancel}" Style="{StaticResource Ghost}"/>
            <Button x:Name="BtnDialogYes" Style="{StaticResource Primary}" Margin="10,0,0,0"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ================= HELP & SUPPORT ================= -->
    <Grid x:Name="SupportLayer" Visibility="Collapsed" Background="{DynamicResource OverlayBrush}">
      <Border x:Name="SupportCard" Width="580" CornerRadius="24" Background="{DynamicResource DialogBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="30,26"
              VerticalAlignment="Center" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
        <StackPanel>
          <Grid>
            <StackPanel Orientation="Horizontal">
              <Border Width="50" Height="50" CornerRadius="15" Background="{StaticResource AccentGrad}">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE897;" FontSize="21" Foreground="White" HorizontalAlignment="Center"/>
              </Border>
              <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource L_help_title}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="{DynamicResource L_help_sub}" FontSize="13" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" MaxWidth="420"/>
              </StackPanel>
            </StackPanel>
            <Button x:Name="BtnSupportClose" Style="{StaticResource IconBtn}" Content="&#xE8BB;" HorizontalAlignment="Right" VerticalAlignment="Top"/>
          </Grid>

          <TextBlock Text="{DynamicResource L_help_type}" Style="{StaticResource Label}" Margin="2,22,0,8"/>
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="RepBug" GroupName="rep" Style="{StaticResource Pill}" Content="{DynamicResource L_help_bug}" IsChecked="True"/>
            <RadioButton x:Name="RepIdea" GroupName="rep" Style="{StaticResource Pill}" Content="{DynamicResource L_help_idea}"/>
            <RadioButton x:Name="RepQuestion" GroupName="rep" Style="{StaticResource Pill}" Content="{DynamicResource L_help_question}" Margin="0"/>
          </StackPanel>

          <TextBlock Text="{DynamicResource L_help_msg}" Style="{StaticResource Label}" Margin="2,18,0,8"/>
          <Grid>
            <TextBox x:Name="RepMessage" Height="130" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Stretch" Padding="12,10"/>
            <TextBlock x:Name="RepHint" Text="{DynamicResource L_help_hint}" Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="15,12,15,0" TextWrapping="Wrap" IsHitTestVisible="False"/>
          </Grid>
          <CheckBox x:Name="RepDiag" Style="{StaticResource CB}" Content="{DynamicResource L_help_diag}" IsChecked="True" Margin="0,14,0,0"/>
          <TextBlock Text="{DynamicResource L_help_diag_d}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="30,3,0,0" TextWrapping="Wrap"/>

          <Grid Margin="0,22,0,0">
            <Button x:Name="BtnRepCopy" Style="{StaticResource Ghost}" Content="{DynamicResource L_help_copy}" HorizontalAlignment="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="BtnRepGmail" Style="{StaticResource Ghost}" Content="{DynamicResource L_help_gmail}"/>
              <Button x:Name="BtnRepMail" Style="{StaticResource Primary}" Content="{DynamicResource L_help_send}" Margin="10,0,0,0"/>
            </StackPanel>
          </Grid>
          <Button x:Name="BtnRepForm" Style="{StaticResource Ghost}" Content="{DynamicResource L_help_form}" HorizontalAlignment="Left" Margin="0,14,0,0"/>
          <TextBlock x:Name="RepEmailLine" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="2,16,0,0" TextWrapping="Wrap"/>
          <Border Margin="0,14,0,0" Padding="12,10" CornerRadius="10" Background="#1AFFB020" BorderBrush="#55FFB020" BorderThickness="1">
            <StackPanel><TextBlock Text="{DynamicResource L_known_wall_h}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextBrush}"/>
              <TextBlock Text="{DynamicResource L_known_wall_d}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ================= WHAT'S NEW (first launch after an update) ================= -->
    <Grid x:Name="WhatsNewLayer" Visibility="Collapsed" Background="{DynamicResource OverlayBrush}">
      <Border x:Name="WhatsNewCard" Width="560" CornerRadius="24" Background="{DynamicResource DialogBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
              VerticalAlignment="Center" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5" ClipToBounds="True">
        <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
        <StackPanel>
          <Border CornerRadius="24,24,0,0" Padding="30,28,30,24">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#557B5CFF" Offset="0"/>
                <GradientStop Color="#2222D3F5" Offset="0.7"/>
                <GradientStop Color="#0022D3F5" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Border Width="52" Height="52" CornerRadius="16" Background="{StaticResource AccentGrad}">
                  <TextBlock x:Name="WnSpark" Style="{StaticResource Icon}" Text="&#xE945;" FontSize="22" Foreground="White" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform><RotateTransform/></TextBlock.RenderTransform>
                  </TextBlock>
                </Border>
                <Border x:Name="WnVersionChip" CornerRadius="999" Padding="12,5" Margin="14,0,0,0" VerticalAlignment="Center" Background="{DynamicResource IconTile}">
                  <TextBlock x:Name="WnVersion" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource CyanBrush}"/>
                </Border>
              </StackPanel>
              <TextBlock x:Name="WnTitle" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,18,0,0" TextWrapping="Wrap"/>
              <TextBlock x:Name="WnSub" FontSize="13.5" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <StackPanel x:Name="WnList" Margin="30,6,30,0"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="30,22,30,26">
            <Button x:Name="BtnWnClose" Content="{DynamicResource L_wn_close}" Style="{StaticResource Ghost}"/>
            <Button x:Name="BtnWnTry" Content="{DynamicResource L_wn_try}" Style="{StaticResource Primary}" Margin="10,0,0,0"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ================= WELCOME (first run) ================= -->
    <Grid x:Name="WelcomeLayer" Visibility="Collapsed" Background="{DynamicResource OverlayBrush}">
      <Border x:Name="WelcomeCard" Width="660" CornerRadius="26" Background="{DynamicResource DialogBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
              VerticalAlignment="Center" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5" ClipToBounds="True">
        <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border Height="220" VerticalAlignment="Top" CornerRadius="26,26,0,0" IsHitTestVisible="False">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#447B5CFF" Offset="0"/>
                <GradientStop Color="#1A22D3F5" Offset="0.65"/>
                <GradientStop Color="#0022D3F5" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
          </Border>
          <Grid Margin="36,34,36,0" MinHeight="440">

            <!-- step 1: hello -->
            <StackPanel x:Name="WStep0">
              <Image x:Name="WLogo" Width="78" Height="78" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform><TranslateTransform/></Image.RenderTransform>
              </Image>
              <TextBlock x:Name="WHello" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource CyanBrush}" Margin="0,22,0,0"/>
              <TextBlock Text="{DynamicResource L_wel_title}" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,4,0,0"/>
              <TextBlock Text="{DynamicResource L_wel_sub}" FontSize="14" LineHeight="22" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
              <UniformGrid Columns="2" Margin="-6,22,-6,0">
                <ContentControl Margin="6">                <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,0">
                  <StackPanel Orientation="Horizontal">
                    <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource IconTile}" VerticalAlignment="Top">
                      <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="16" Foreground="#9C8BFF" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" Width="196">
                      <TextBlock Text="{DynamicResource L_wel_f1}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                      <TextBlock Text="{DynamicResource L_wel_f1_d}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                  </StackPanel>
                </Border></ContentControl>
                <ContentControl Margin="6">                <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,0">
                  <StackPanel Orientation="Horizontal">
                    <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource IconTile}" VerticalAlignment="Top">
                      <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="16" Foreground="#9C8BFF" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" Width="196">
                      <TextBlock Text="{DynamicResource L_wel_f2}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                      <TextBlock Text="{DynamicResource L_wel_f2_d}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                  </StackPanel>
                </Border></ContentControl>
                <ContentControl Margin="6">                <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,0">
                  <StackPanel Orientation="Horizontal">
                    <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource IconTile}" VerticalAlignment="Top">
                      <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="16" Foreground="#9C8BFF" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" Width="196">
                      <TextBlock Text="{DynamicResource L_wel_f3}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                      <TextBlock Text="{DynamicResource L_wel_f3_d}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                  </StackPanel>
                </Border></ContentControl>
                <ContentControl Margin="6">                <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,0">
                  <StackPanel Orientation="Horizontal">
                    <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource IconTile}" VerticalAlignment="Top">
                      <TextBlock Style="{StaticResource Icon}" Text="&#xE9D9;" FontSize="16" Foreground="#9C8BFF" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" Width="196">
                      <TextBlock Text="{DynamicResource L_wel_f4}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                      <TextBlock Text="{DynamicResource L_wel_f4_d}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                  </StackPanel>
                </Border></ContentControl>
              </UniformGrid>
            </StackPanel>

            <!-- step 2: make it yours -->
            <StackPanel x:Name="WStep1" Visibility="Collapsed">
              <TextBlock Text="{DynamicResource L_wel_step2}" Style="{StaticResource Label}"/>
              <TextBlock Text="{DynamicResource L_wel_setup}" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,8,0,0"/>
              <TextBlock Text="{DynamicResource L_wel_setup_d}" FontSize="14" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,14"/>
              <Grid Margin="0,10">
                <StackPanel Margin="0,0,300,0"><TextBlock Text="{DynamicResource L_set_lang}" Style="{StaticResource H2}"/><TextBlock Text="{DynamicResource L_set_lang_d}" Style="{StaticResource Sub}"/></StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <RadioButton x:Name="WLangEn" GroupName="wlang" Style="{StaticResource Pill}" Content="English"/>
                  <RadioButton x:Name="WLangMs" GroupName="wlang" Style="{StaticResource Pill}" Content="Bahasa Melayu" Margin="0"/>
                </StackPanel>
              </Grid>
              <Border Height="1" Background="{DynamicResource LineBrush}"/>
              <Grid Margin="0,10">
                <StackPanel Margin="0,0,300,0"><TextBlock Text="{DynamicResource L_set_theme}" Style="{StaticResource H2}"/><TextBlock Text="{DynamicResource L_set_theme_d}" Style="{StaticResource Sub}"/></StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <RadioButton x:Name="WThemeDark" GroupName="wtheme" Style="{StaticResource Pill}" Content="{DynamicResource L_dark}"/>
                  <RadioButton x:Name="WThemeLight" GroupName="wtheme" Style="{StaticResource Pill}" Content="{DynamicResource L_light}"/>
                  <RadioButton x:Name="WThemeSystem" GroupName="wtheme" Style="{StaticResource Pill}" Content="{DynamicResource L_system}" Margin="0"/>
                </StackPanel>
              </Grid>
              <Border Height="1" Background="{DynamicResource LineBrush}"/>
              <Grid Margin="0,10">
                <StackPanel Margin="0,0,300,0"><TextBlock Text="{DynamicResource L_set_startup}" Style="{StaticResource H2}"/><TextBlock Text="{DynamicResource L_set_startup_d}" Style="{StaticResource Sub}"/></StackPanel>
                <CheckBox x:Name="WStartup" Style="{StaticResource Switch}" HorizontalAlignment="Right"/>
              </Grid>
              <Border Height="1" Background="{DynamicResource LineBrush}"/>
              <Grid Margin="0,10">
                <StackPanel Margin="0,0,300,0"><TextBlock Text="{DynamicResource L_wel_auto}" Style="{StaticResource H2}"/><TextBlock Text="{DynamicResource L_wel_auto_d}" Style="{StaticResource Sub}"/></StackPanel>
                <CheckBox x:Name="WAuto" Style="{StaticResource Switch}" HorizontalAlignment="Right"/>
              </Grid>
            </StackPanel>

            <!-- step 3: ready -->
            <StackPanel x:Name="WStep2" Visibility="Collapsed">
              <Border x:Name="WDoneBadge" Width="78" Height="78" CornerRadius="39" Background="{StaticResource AccentGrad}" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="32" Foreground="White" HorizontalAlignment="Center"/>
              </Border>
              <TextBlock Text="{DynamicResource L_wel_ready}" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,24,0,0"/>
              <TextBlock Text="{DynamicResource L_wel_ready_d}" FontSize="14" LineHeight="22" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,22"/>
              <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="18" Foreground="{StaticResource CyanBrush}" VerticalAlignment="Top" Margin="0,2,14,0"/>
                  <StackPanel Width="500"><TextBlock Text="{DynamicResource L_wel_privacy}" Style="{StaticResource H2}"/><TextBlock Text="{DynamicResource L_wel_privacy_d}" Style="{StaticResource Sub}"/></StackPanel>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}" Padding="18,16">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE897;" FontSize="18" Foreground="{StaticResource CyanBrush}" VerticalAlignment="Top" Margin="0,2,14,0"/>
                  <StackPanel Width="500"><TextBlock Text="{DynamicResource L_wel_help}" Style="{StaticResource H2}"/><TextBlock Text="{DynamicResource L_wel_help_d}" Style="{StaticResource Sub}"/></StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>

          <!-- footer -->
          <Grid Grid.Row="1" Margin="36,18,36,28">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border x:Name="WDot0" Width="22" Height="7" CornerRadius="4" Background="{StaticResource AccentGrad}" Margin="0,0,6,0"/>
              <Border x:Name="WDot1" Width="7" Height="7" CornerRadius="4" Background="{DynamicResource LineBrush}" Margin="0,0,6,0"/>
              <Border x:Name="WDot2" Width="7" Height="7" CornerRadius="4" Background="{DynamicResource LineBrush}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="BtnWSkip" Style="{StaticResource Ghost}" Content="{DynamicResource L_wel_skip}"/>
              <Button x:Name="BtnWBack" Style="{StaticResource Ghost}" Content="{DynamicResource L_wel_back}" Visibility="Collapsed"/>
              <Button x:Name="BtnWNext" Style="{StaticResource Primary}" Content="{DynamicResource L_wel_start}" Margin="10,0,0,0" Padding="28,0"/>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
