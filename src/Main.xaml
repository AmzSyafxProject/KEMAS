              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,16,0">
                <TextBlock Text="{DynamicResource L_org_title}" Style="{StaticResource H1}"/>
                <TextBlock Text="{DynamicResource L_org_sub}" Style="{StaticResource Sub}"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="BtnUndo" Content="{DynamicResource L_undo}" Style="{StaticResource Ghost}"/>
                <Button x:Name="BtnPreview" Content="{DynamicResource L_preview}" Style="{StaticResource Ghost}" Margin="10,0,0,0"/>
                <Button x:Name="BtnOrganize" Content="{DynamicResource L_organize}" Style="{StaticResource Primary}" Margin="10,0,0,0"/>
              </StackPanel>
            </Grid>
            <Grid Grid.Row="1" Margin="0,0,0,14">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="OrgTabFolders" GroupName="orgtab" Style="{StaticResource Pill}" Content="{DynamicResource L_org_tab_folders}" IsChecked="True"/>
                <RadioButton x:Name="OrgTabRules" GroupName="orgtab" Style="{StaticResource Pill}" Content="{DynamicResource L_org_tab_rules}"/>
                <RadioButton x:Name="OrgTabPreview" GroupName="orgtab" Style="{StaticResource Pill}" Content="{DynamicResource L_org_tab_preview}"/>
              </StackPanel>
              <StackPanel x:Name="SavedHint" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" Foreground="{StaticResource GoodBrush}" FontSize="12"/>
                <TextBlock Text="{DynamicResource L_saved}" Foreground="{StaticResource GoodBrush}" FontSize="12.5" Margin="6,0,0,0"/>
              </StackPanel>
            </Grid>

            <!-- folders -->
            <Grid x:Name="OrgFoldersPanel" Grid.Row="2">
              <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
