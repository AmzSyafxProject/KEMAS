<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KEMAS" Width="1200" Height="760" MinWidth="1060" MinHeight="680"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Display, Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal">
  <Window.Resources>
    <LinearGradientBrush x:Key="AccentGrad" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#7B5CFF" Offset="0"/>
      <GradientStop Color="#2FD4FF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CyanBrush" Color="#22C4F0"/>
    <SolidColorBrush x:Key="GoodBrush" Color="#21C98A"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#F5A524"/>
    <SolidColorBrush x:Key="BadBrush" Color="#F2557A"/>

    <Style x:Key="H1" TargetType="TextBlock">
      <Setter Property="FontSize" Value="28"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
    <Style x:Key="Sub" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="Margin" Value="0,4,0,0"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    </Style>
    <Style x:Key="Big" TargetType="TextBlock">
      <Setter Property="FontSize" Value="26"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="18"/>
      <Setter Property="Padding" Value="22,18"/>
    </Style>
    <Style x:Key="Icon" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- navigation -->
    <Style x:Key="Nav" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="GroupName" Value="nav"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="bd" CornerRadius="12" Background="Transparent" Padding="14,0">
              <Grid>
                <Border x:Name="bar" Width="3" Height="18" CornerRadius="2" HorizontalAlignment="Left" Margin="-14,0,0,0"
                        Background="{StaticResource AccentGrad}" Opacity="0"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock x:Name="ic" Text="{TemplateBinding Tag}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="26" VerticalAlignment="Center"/>
                  <ContentPresenter VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelectBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter TargetName="bar" Property="Opacity" Value="1"/>
                <Setter TargetName="ic" Property="Foreground" Value="{StaticResource CyanBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- buttons -->
    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="22,0"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="20" Background="{StaticResource AccentGrad}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.9"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.75"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource Primary}">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="20" Background="{DynamicResource GhostBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource SelectBrush}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource Primary}">
      <Setter Property="Foreground" Value="{StaticResource BadBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="20" Background="#1FF2557A" BorderBrush="#55F2557A" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#33F2557A"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="IconBtn" TargetType="Button">
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="Transparent" CornerRadius="10">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="WinBtn" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- checkbox -->
    <Style x:Key="CB" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="box" Width="20" Height="20" CornerRadius="6" BorderThickness="2" BorderBrush="{DynamicResource BoxBrush}" Background="Transparent" VerticalAlignment="Center">
                <Path x:Name="mark" Data="M 3 8 L 6.5 11.5 L 13 4.5" Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="#7B5CFF"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="{StaticResource AccentGrad}"/>
                <Setter TargetName="box" Property="BorderBrush" Value="Transparent"/>
                <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- toggle switch -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Width="46" Height="26" Background="Transparent">
              <Border x:Name="track" CornerRadius="13" Background="{DynamicResource TrackBrush}" BorderBrush="{DynamicResource BoxBrush}" BorderThickness="1"/>
              <Ellipse x:Name="knob" Width="18" Height="18" HorizontalAlignment="Left" Margin="4,0,0,0" Fill="{DynamicResource MutedBrush}">
                <Ellipse.RenderTransform><TranslateTransform x:Name="kt" X="0"/></Ellipse.RenderTransform>
              </Ellipse>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="{StaticResource AccentGrad}"/>
                <Setter TargetName="track" Property="BorderBrush" Value="Transparent"/>
                <Setter TargetName="knob" Property="Fill" Value="White"/>
                <Trigger.EnterActions>
                  <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="kt" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.16"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="kt" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- pill choice -->
    <Style x:Key="Pill" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="bd" CornerRadius="10" Padding="13,6" Background="{DynamicResource GhostBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentGrad}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="8"/>
      <Setter Property="Minimum" Value="0"/>
      <Setter Property="Maximum" Value="100"/>
      <Setter Property="Foreground" Value="{StaticResource AccentGrad}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" CornerRadius="5" Background="{DynamicResource TrackBrush}"/>
              <Border x:Name="PART_Indicator" CornerRadius="5" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11" Padding="{TemplateBinding Padding}">
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="#7B5CFF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8"/>
      <Setter Property="MinWidth" Value="8"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border CornerRadius="4" Background="{DynamicResource ThumbBrush}"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="MinWidth" Value="0"/>
          <Setter Property="Height" Value="8"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Track x:Name="PART_Track">
                  <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border CornerRadius="4" Background="{DynamicResource ThumbBrush}"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                </Track>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ScrollViewer">
      <Setter Property="PanningMode" Value="VerticalOnly"/>
    </Style>

    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="RowBackground" Value="Transparent"/>
      <Setter Property="AlternatingRowBackground" Value="{DynamicResource AltRowBrush}"/>
      <Setter Property="AlternationCount" Value="2"/>
      <Setter Property="GridLinesVisibility" Value="None"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="AutoGenerateColumns" Value="False"/>
      <Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="CanUserDeleteRows" Value="False"/>
      <Setter Property="CanUserResizeRows" Value="False"/>
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="SelectionUnit" Value="FullRow"/>
      <Setter Property="RowHeight" Value="38"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="EnableRowVirtualization" Value="True"/>
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
      <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridColumnHeader">
            <Border Background="{DynamicResource AltRowBrush}" Padding="12,10" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="DataGridRow">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border Background="{TemplateBinding Background}" Padding="12,0">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#4D7B5CFF"/>
          <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="{DynamicResource DialogBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    </Style>
  </Window.Resources>

  <Grid x:Name="Root">
    <!-- aurora -->
    <Canvas x:Name="Aurora" IsHitTestVisible="False" ClipToBounds="True">
      <Ellipse x:Name="AuroraA" Width="660" Height="660" Canvas.Left="460" Canvas.Top="-340" Fill="{DynamicResource AuroraA}">
        <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
      </Ellipse>
      <Ellipse x:Name="AuroraB" Width="580" Height="580" Canvas.Left="780" Canvas.Top="340" Fill="{DynamicResource AuroraB}">
        <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
      </Ellipse>
      <Ellipse x:Name="AuroraC" Width="480" Height="480" Canvas.Left="140" Canvas.Top="450" Fill="{DynamicResource AuroraC}">
        <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
      </Ellipse>
    </Canvas>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="236"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- ===== sidebar ===== -->
      <Border x:Name="SideBar" Background="{DynamicResource SideBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
        <DockPanel Margin="16,18,16,16">
          <StackPanel x:Name="Brand" DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,4,0,30" Background="Transparent">
            <Image x:Name="SideLogo" Width="40" Height="40"/>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="KEMAS" FontSize="20" FontWeight="Black" Foreground="{DynamicResource TextBrush}"/>
              <TextBlock Text="{DynamicResource L_tagline}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
            </StackPanel>
          </StackPanel>

          <StackPanel DockPanel.Dock="Bottom">
            <Border x:Name="UpdateChip" Visibility="Collapsed" CornerRadius="12" Background="#1F7B5CFF" BorderBrush="#557B5CFF" BorderThickness="1" Padding="12,10" Margin="0,0,0,10" Cursor="Hand">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Foreground="{StaticResource CyanBrush}" FontSize="14"/>
                <StackPanel Margin="10,0,0,0">
                  <TextBlock Text="{DynamicResource L_update_ready}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                  <TextBlock x:Name="UpdateChipText" FontSize="11.5" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <RadioButton x:Name="NavSettings" Style="{StaticResource Nav}" Tag="&#xE713;" Content="{DynamicResource L_nav_settings}"/>
            <RadioButton x:Name="NavAbout" Style="{StaticResource Nav}" Tag="&#xE946;" Content="{DynamicResource L_nav_about}"/>
          </StackPanel>

          <StackPanel>
            <RadioButton x:Name="NavDash" Style="{StaticResource Nav}" Tag="&#xE80F;" Content="{DynamicResource L_nav_dash}" IsChecked="True"/>
            <RadioButton x:Name="NavClean" Style="{StaticResource Nav}" Tag="&#xE74D;" Content="{DynamicResource L_nav_clean}"/>
            <RadioButton x:Name="NavOrg" Style="{StaticResource Nav}" Tag="&#xE8B7;" Content="{DynamicResource L_nav_org}"/>
            <RadioButton x:Name="NavRam" Style="{StaticResource Nav}" Tag="&#xE9D9;" Content="{DynamicResource L_nav_ram}"/>
            <RadioButton x:Name="NavStartup" Style="{StaticResource Nav}" Tag="&#xE7E8;" Content="{DynamicResource L_nav_startup}"/>
            <RadioButton x:Name="NavApps" Style="{StaticResource Nav}" Tag="&#xE71D;" Content="{DynamicResource L_nav_apps}"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- ===== main ===== -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="42"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar" Background="Transparent">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button x:Name="BtnMin" Style="{StaticResource WinBtn}" Content="&#xE921;" Tag="{DynamicResource HoverBrush}"/>
            <Button x:Name="BtnMax" Style="{StaticResource WinBtn}" Content="&#xE922;" Tag="{DynamicResource HoverBrush}"/>
            <Button x:Name="BtnClose" Style="{StaticResource WinBtn}" Content="&#xE8BB;" Tag="#E5484D"/>
          </StackPanel>
        </Grid>

        <Grid x:Name="Pages" Grid.Row="1" Margin="34,0,34,4">
          <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>

          <!-- ================= DASHBOARD ================= -->
          <Grid x:Name="PageDash">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,18">
              <TextBlock x:Name="Greeting" Style="{StaticResource H1}"/>
              <TextBlock x:Name="DateText" Style="{StaticResource Sub}"/>
            </StackPanel>

            <Border Grid.Row="1" CornerRadius="24" Padding="26,22" Margin="0,0,0,16" Background="{DynamicResource HeroBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Width="196" Height="196">
                  <Ellipse Width="164" Height="164" Fill="{DynamicResource RingGlow}"/>
                  <Ellipse Width="184" Height="184" Stroke="{DynamicResource TrackBrush}" StrokeThickness="13"/>
                  <Path x:Name="RingArc" Stroke="{StaticResource AccentGrad}" StrokeThickness="13" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="ScoreText" Text="--" FontSize="54" FontWeight="Bold" Foreground="{DynamicResource HeroText}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource L_health}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource HeroMuted}" HorizontalAlignment="Center" Margin="0,-4,0,0"/>
                  </StackPanel>
                </Grid>
                <StackPanel Grid.Column="1" Margin="30,0,0,0" VerticalAlignment="Center">
                  <TextBlock x:Name="ScoreTitle" Text="{DynamicResource L_checking}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource HeroText}" TextWrapping="Wrap"/>
                  <TextBlock x:Name="ScoreDesc" Text="{DynamicResource L_checking_desc}" Foreground="{DynamicResource HeroMuted}" FontSize="13.5" Margin="0,6,0,0" TextWrapping="Wrap"/>
                  <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <Button x:Name="BtnSmart" Style="{StaticResource Primary}" Height="48" Padding="30,0" FontSize="15" RenderTransformOrigin="0.5,0.5">
                      <Button.RenderTransform><ScaleTransform/></Button.RenderTransform>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="15" Margin="0,0,10,0"/>
                        <TextBlock Text="{DynamicResource L_smart}" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                    <Button x:Name="BtnDashScan" Style="{StaticResource Ghost}" Height="48" Padding="26,0" Margin="12,0,0,0" Content="{DynamicResource L_scan_again}"/>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock x:Name="DiskLabel" Style="{StaticResource Label}"/>
                  <TextBlock x:Name="DiskUsedText" Text="-" Style="{StaticResource Big}"/>
                  <ProgressBar x:Name="DiskBar" Margin="0,12,0,10"/>
                  <TextBlock x:Name="DiskFreeText" Style="{StaticResource Sub}"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="{DynamicResource L_ram_card}" Style="{StaticResource Label}"/>
                  <TextBlock x:Name="RamUsedText" Text="-" Style="{StaticResource Big}"/>
                  <ProgressBar x:Name="RamBar" Margin="0,12,0,10"/>
                  <TextBlock x:Name="RamFreeText" Style="{StaticResource Sub}"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="4" Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="{DynamicResource L_junk_card}" Style="{StaticResource Label}"/>
                  <TextBlock x:Name="JunkText" Text="..." Style="{StaticResource Big}" Foreground="{StaticResource CyanBrush}"/>
                  <TextBlock x:Name="JunkSub" Style="{StaticResource Sub}" Margin="0,12,0,0"/>
                  <TextBlock x:Name="LastCleanText" Style="{StaticResource Sub}" Foreground="{StaticResource GoodBrush}"/>
                </StackPanel>
              </Border>
            </Grid>

            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="22,14">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource L_activity}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                <TextBox x:Name="LogBox" IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0" Height="Auto"
                         FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
              </DockPanel>
            </Border>
          </Grid>

          <!-- ================= CLEANER ================= -->
          <Grid x:Name="PageClean" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,20">
              <StackPanel Margin="0,0,440,0">
                <TextBlock Text="{DynamicResource L_clean_title}" Style="{StaticResource H1}"/>
                <TextBlock Text="{DynamicResource L_clean_sub}" Style="{StaticResource Sub}"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="BtnSelAll" Content="{DynamicResource L_select_all}" Style="{StaticResource Ghost}"/>
                <Button x:Name="BtnScan" Content="{DynamicResource L_scan_again}" Style="{StaticResource Ghost}" Margin="10,0,0,0"/>
                <Button x:Name="BtnDeep" Style="{StaticResource Primary}" Margin="10,0,0,0" Padding="18,0" ToolTip="{DynamicResource L_deep_tip}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="14" Foreground="White" Margin="0,0,8,0"/>
                    <TextBlock Text="{DynamicResource L_deep_btn}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="CleanList" Margin="0,0,10,0"/>
            </ScrollViewer>
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="22,14">
              <Grid>
                <StackPanel>
                  <TextBlock x:Name="SelTotal" Text="0 B" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                  <TextBlock x:Name="SelCount" Style="{StaticResource Sub}" Margin="0,2,0,0"/>
                </StackPanel>
                <Button x:Name="BtnClean" Content="{DynamicResource L_clean_selected}" Style="{StaticResource Primary}" HorizontalAlignment="Right" Padding="30,0"/>
              </Grid>
            </Border>
          </Grid>

          <!-- ================= ORGANIZER ================= -->
          <Grid x:Name="PageOrg" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,16">
              <StackPanel Margin="0,0,420,0">
                <TextBlock Text="{DynamicResource L_org_title}" Style="{StaticResource H1}"/>
                <TextBlock Text="{DynamicResource L_org_sub}" Style="{StaticResource Sub}"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="BtnUndo" Content="{DynamicResource L_undo}" Style="{StaticResource Ghost}"/>
                <Button x:Name="BtnPreview" Content="{DynamicResource L_preview}" Style="{StaticResource Ghost}" Margin="10,0,0,0"/>
                <Button x:Name="BtnOrganize" Content="{DynamicResource L_organize}" Style="{StaticResource Primary}" Margin="10,0,0,0"/>
              </StackPanel>
            </Grid>
            <Grid Grid.Row="1" Margin="0,0,0,14">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="OrgTabFolders" GroupName="orgtab" Style="{StaticResource Pill}" Content="{DynamicResource L_org_tab_folders}" IsChecked="True"/>
                <RadioButton x:Name="OrgTabRules" GroupName="orgtab" Style="{StaticResource Pill}" Content="{DynamicResource L_org_tab_rules}"/>
                <RadioButton x:Name="OrgTabPreview" GroupName="orgtab" Style="{StaticResource Pill}" Content="{DynamicResource L_org_tab_preview}"/>
              </StackPanel>
              <StackPanel x:Name="SavedHint" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" Foreground="{StaticResource GoodBrush}" FontSize="12"/>
                <TextBlock Text="{DynamicResource L_saved}" Foreground="{StaticResource GoodBrush}" FontSize="12.5" Margin="6,0,0,0"/>
              </StackPanel>
            </Grid>

            <!-- folders -->
            <Grid x:Name="OrgFoldersPanel" Grid.Row="2">
              <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="OrgFolderList" Margin="0,0,10,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,10">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <CheckBox Style="{StaticResource CB}" IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center" Tag="changed"/>
                          <StackPanel Grid.Column="1" Margin="4,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="{Binding Path}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                          </StackPanel>
                          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton Style="{StaticResource Pill}" GroupName="{Binding Group}" IsChecked="{Binding ByType, Mode=TwoWay}" Content="{DynamicResource L_by_type}"/>
                            <RadioButton Style="{StaticResource Pill}" GroupName="{Binding Group}" IsChecked="{Binding ByDate, Mode=TwoWay}" Content="{DynamicResource L_by_date}"/>
                            <Button Style="{StaticResource IconBtn}" Content="&#xE74D;" Tag="removefolder" ToolTip="{DynamicResource L_remove}" Margin="6,0,0,0"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="BtnAddFolder" Style="{StaticResource Ghost}">
                  <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="{DynamicResource L_add_folder}"/></StackPanel>
                </Button>
                <TextBlock Text="{DynamicResource L_date_format}" Style="{StaticResource Sub}" VerticalAlignment="Center" Margin="22,0,10,0"/>
                <RadioButton x:Name="DateFmt0" GroupName="datefmt" Style="{StaticResource Pill}" Content="2026\10 - October"/>
                <RadioButton x:Name="DateFmt1" GroupName="datefmt" Style="{StaticResource Pill}" Content="2026-10"/>
                <RadioButton x:Name="DateFmt2" GroupName="datefmt" Style="{StaticResource Pill}" Content="2026\October"/>
              </StackPanel>
            </Grid>

            <!-- rules -->
            <Grid x:Name="OrgRulesPanel" Grid.Row="2" Visibility="Collapsed">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid Margin="16,0,60,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource L_rule_folder}" Style="{StaticResource Label}"/>
                <TextBlock Grid.Column="1" Text="{DynamicResource L_rule_types}" Style="{StaticResource Label}" Margin="12,0,0,0"/>
              </Grid>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="OrgRuleList" Margin="0,0,10,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,8">
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=500}" FontWeight="SemiBold"/>
                          <TextBox Grid.Column="1" Margin="12,0,0,0" Text="{Binding Extensions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=500}"/>
                          <Button Grid.Column="2" Style="{StaticResource IconBtn}" Content="&#xE74D;" Tag="removerule" ToolTip="{DynamicResource L_remove}" Margin="8,0,0,0"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <Grid Grid.Row="2" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="BtnAddRule" Style="{StaticResource Ghost}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="{DynamicResource L_add_rule}"/></StackPanel>
                  </Button>
                  <TextBlock Text="{DynamicResource L_others_name}" Style="{StaticResource Sub}" VerticalAlignment="Center" Margin="18,0,10,0"/>
                  <TextBox x:Name="OthersName" Width="150"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button x:Name="BtnImport" Style="{StaticResource Ghost}" Content="{DynamicResource L_import}"/>
                  <Button x:Name="BtnExport" Style="{StaticResource Ghost}" Content="{DynamicResource L_export}" Margin="8,0,0,0"/>
                  <Button x:Name="BtnResetRules" Style="{StaticResource Ghost}" Content="{DynamicResource L_reset}" Margin="8,0,0,0"/>
                </StackPanel>
              </Grid>
            </Grid>

            <!-- preview -->
            <Grid x:Name="OrgPreviewPanel" Grid.Row="2" Visibility="Collapsed">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <TextBlock x:Name="OrgSummary" Style="{StaticResource Sub}" Margin="2,0,0,10" Text="{DynamicResource L_org_hint}"/>
              <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6">
                <DataGrid x:Name="OrgGrid" SelectionMode="Extended">
                  <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding File}" Width="2*"/>
                    <DataGridTextColumn Binding="{Binding Folder}" Width="110"/>
                    <DataGridTextColumn Binding="{Binding Destination}" Width="1.6*"/>
                    <DataGridTextColumn Binding="{Binding Size}" SortMemberPath="Bytes" Width="100"/>
                  </DataGrid.Columns>
                </DataGrid>
              </Border>
            </Grid>
          </Grid>

          <!-- ================= MEMORY ================= -->
          <Grid x:Name="PageRam" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,20">
              <StackPanel Margin="0,0,420,0">
                <TextBlock Text="{DynamicResource L_ram_title}" Style="{StaticResource H1}"/>
                <TextBlock Text="{DynamicResource L_ram_sub}" Style="{StaticResource Sub}"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="BtnRamRefresh" Content="{DynamicResource L_refresh}" Style="{StaticResource Ghost}"/>
                <Button x:Name="BtnTrim" Content="{DynamicResource L_free_ram}" Style="{StaticResource Primary}" Margin="10,0,0,0"/>
                <Button x:Name="BtnKill" Content="{DynamicResource L_end_selected}" Style="{StaticResource Danger}" Margin="10,0,0,0"/>
              </StackPanel>
            </Grid>
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <Grid>
                  <TextBlock x:Name="RamPageText" Text="-" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                  <TextBlock x:Name="RamPagePct" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource CyanBrush}" HorizontalAlignment="Right"/>
                </Grid>
                <ProgressBar x:Name="RamPageBar" Height="12" Margin="0,12,0,0"/>
              </StackPanel>
            </Border>
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6">
              <DataGrid x:Name="ProcGrid" SelectionMode="Extended">
                <DataGrid.Columns>
                  <DataGridTextColumn Binding="{Binding App}" Width="1.3*"/>
                  <DataGridTextColumn Binding="{Binding RAM}" SortMemberPath="RamMB" Width="110"/>
                  <DataGridTextColumn Binding="{Binding Procs}" Width="95"/>
                  <DataGridTextColumn Binding="{Binding Description}" Width="2*"/>
                  <DataGridTextColumn Binding="{Binding Status}" Width="110"/>
                </DataGrid.Columns>
              </DataGrid>
            </Border>
            <TextBlock Grid.Row="3" Style="{StaticResource Sub}" Margin="2,10,0,0" Text="{DynamicResource L_ram_tip}"/>
          </Grid>

          <!-- ================= STARTUP APPS ================= -->
          <Grid x:Name="PageStartup" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,20">
              <StackPanel Margin="0,0,200,0">
                <TextBlock Text="{DynamicResource L_startup_title}" Style="{StaticResource H1}"/>
                <TextBlock Text="{DynamicResource L_startup_sub}" Style="{StaticResource Sub}"/>
              </StackPanel>
              <Button x:Name="BtnStartupRefresh" Content="{DynamicResource L_refresh}" Style="{StaticResource Ghost}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <ItemsControl x:Name="StartupList" Margin="0,0,10,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,8">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource IconTile}">
                          <TextBlock Style="{StaticResource Icon}" Text="&#xE7E8;" FontSize="16" Foreground="#9C8BFF" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                          <TextBlock FontSize="12" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Command}">
                            <Run Text="{Binding Location, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Command, Mode=OneWay}"/>
                          </TextBlock>
                        </StackPanel>
                        <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding Enabled, Mode=OneWay}" Tag="startup"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="StartupSummary" Grid.Row="2" Style="{StaticResource Sub}" Margin="2,10,0,0"/>
          </Grid>

          <!-- ================= PROGRAMS ================= -->
          <Grid x:Name="PageApps" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,20">
              <StackPanel Margin="0,0,480,0">
                <TextBlock Text="{DynamicResource L_apps_title}" Style="{StaticResource H1}"/>
                <TextBlock Text="{DynamicResource L_apps_sub}" Style="{StaticResource Sub}"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Grid Width="220">
                  <TextBox x:Name="AppSearch"/>
                  <TextBlock x:Name="AppSearchHint" Text="{DynamicResource L_search}" Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
                <Button x:Name="BtnAppsRefresh" Content="{DynamicResource L_refresh}" Style="{StaticResource Ghost}" Margin="10,0,0,0"/>
                <Button x:Name="BtnUninstall" Content="{DynamicResource L_uninstall}" Style="{StaticResource Danger}" Margin="10,0,0,0"/>
              </StackPanel>
            </Grid>
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6">
              <DataGrid x:Name="AppGrid" SelectionMode="Single">
                <DataGrid.Columns>
                  <DataGridTextColumn Binding="{Binding Name}" Width="2*"/>
                  <DataGridTextColumn Binding="{Binding Publisher}" Width="1.3*"/>
                  <DataGridTextColumn Binding="{Binding Size}" SortMemberPath="SizeMB" Width="100"/>
                  <DataGridTextColumn Binding="{Binding Version}" Width="110"/>
                  <DataGridTextColumn Binding="{Binding Installed}" SortMemberPath="InstallSort" Width="110"/>
                </DataGrid.Columns>
              </DataGrid>
            </Border>
            <TextBlock x:Name="AppSummary" Grid.Row="2" Style="{StaticResource Sub}" Margin="2,10,0,0"/>
          </Grid>

          <!-- ================= SETTINGS ================= -->
          <Grid x:Name="PageSettings" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,18">
              <TextBlock Text="{DynamicResource L_settings_title}" Style="{StaticResource H1}"/>
              <TextBlock Text="{DynamicResource L_settings_sub}" Style="{StaticResource Sub}"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="0,0,10,10">
                <TextBlock Text="{DynamicResource L_set_appearance}" Style="{StaticResource Label}" Margin="4,0,0,8"/>
                <Border Style="{StaticResource Card}" Padding="20,6" Margin="0,0,0,18">
                  <StackPanel>
                    <Grid Margin="0,10">
                      <StackPanel Margin="0,0,330,0"><TextBlock Text="{DynamicResource L_set_theme}" Style="{StaticResource H2}"/><TextBlock Text="{DynamicResource L_set_theme_d}" Style="{StaticResource Sub}"/></StackPanel>
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <RadioButton x:Name="ThemeDark" GroupName="theme" Style="{StaticResource Pill}" Content="{DynamicResource L_dark}"/>
                        <RadioButton x:Name="ThemeLight" GroupName="theme" Style="{StaticResource Pill}" Content="{DynamicResource L_light}"/>
                        <RadioButton x:Name="ThemeSystem" GroupName="theme" Style="{StaticResource Pill}" Content="{DynamicResource L_system}" Margin="0"/>
                      </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource LineBrush}"/>
                    <Grid Margin="0,10">
                      <StackPanel Margin="0,0,330,0"><TextBlock Text="{DynamicResource L_set_lang}" Style="{StaticResource H2}"/><TextBlock Text="{DynamicResource L_set_lang_d}" Style="{StaticResource Sub}"/></StackPanel>
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <RadioButton x:Name="LangEn" GroupName="lang" Style="{StaticResource Pill}" Content="English"/>
                        <RadioButton x:Name="LangMs" GroupName="lang" Style="{StaticResource Pill}" Content="Bahasa Melayu" Margin="0"/>
                      </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource LineBrush}"/>
                    <Grid Margin="0,10">
                      <StackPanel Margin="0,0,100,0"><TextBlock Text="{DynamicResource L_set_motion}" Style="{StaticResource H2}"/><TextBlock x:Name="MotionDesc" Style="{StaticResource Sub}"/></StackPanel>
                      <CheckBox x:Name="SetMotion" Style="{StaticResource Switch}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource LineBrush}"/>
                    <Grid Margin="0,10">
                      <StackPanel Margin="0,0,330,0"><TextBlock Text="{DynamicResource L_set_name}" Style="{StaticResource H2}"/><TextBlock Text="{DynamicResource L_set_name_d}" Style="{StaticResource Sub}"/></StackPanel>
                      <Grid Width="240" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBox x:Name="SetName"/>
                        <TextBlock x:Name="SetNameHint" Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                      </Grid>
                    </Grid>
                  </StackPanel>
                </Border>

                <TextBlock Text="{DynamicResource L_set_general}" Style="{StaticResource Label}" Margin="4,0,0,8"/>
                <Border Style="{StaticResource Card}" Padding="20,6" Margin="0,0,0,18">
                  <StackPanel>
                    <Grid Margin="0,10">
                      <StackPanel Margin="0,0,100,0"><TextBlock Text="{DynamicResource L_set_startup}" Style="{StaticResource H2}"/><TextBlock Text="{DynamicResource L_set_startup_d}" Style="{StaticResource Sub}"/></StackPanel>
                      <CheckBox x:Name="SetStartup" Style="{StaticResource Switch}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource LineBrush}"/>
                    <Grid Margin="0,10">
                      <StackPanel Margin="0,0,100,0"><TextBlock Text="{DynamicResource L_set_tray}" Style="{StaticResource H2}"/><TextBlock Text="{DynamicResource L_set_tray_d}" Style="{StaticResource Sub}"/></StackPanel>
                      <CheckBox x:Name="SetTray" Style="{StaticResource Switch}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource LineBrush}"/>
                    <Grid Margin="0,10">
                      <StackPanel Margin="0,0,100,0"><TextBlock Text="{DynamicResource L_set_scanstart}" Style="{StaticResource H2}"/><TextBlock Text="{DynamicResource L_set_scanstart_d}" Style="{StaticResource Sub}"/></StackPanel>
                      <CheckBox x:Name="SetScanStart" Style="{StaticResource Switch}" HorizontalAlignment="Right"/>
                    </Grid>
                  </StackPanel>
                </Border>

                <TextBlock Text="{DynamicResource L_set_cleaning}" Style="{StaticResource Label}" Margin="4,0,0,8"/>
                <Border Style="{StaticResource Card}" Padding="20,6" Margin="0,0,0,18">
                  <StackPanel>
                    <Grid Margin="0,10">
                      <StackPanel Margin="0,0,330,0"><TextBlock Text="{DynamicResource L_set_auto}" Style="{StaticResource H2}"/><TextBlock Text="{DynamicResource L_set_auto_d}" Style="{StaticResource Sub}"/></StackPanel>
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <RadioButton x:Name="AutoOff" GroupName="auto" Style="{StaticResource Pill}" Content="{DynamicResource L_off}"/>
                        <RadioButton x:Name="AutoDaily" GroupName="auto" Style="{StaticResource Pill}" Content="{DynamicResource L_daily}"/>
                        <RadioButton x:Name="AutoWeekly" GroupName="auto" Style="{StaticResource Pill}" Content="{DynamicResource L_weekly}" Margin="0"/>
                      </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource LineBrush}"/>
                    <Grid Margin="0,10">
                      <StackPanel Margin="0,0,100,0"><TextBlock Text="{DynamicResource L_set_confirm}" Style="{StaticResource H2}"/><TextBlock Text="{DynamicResource L_set_confirm_d}" Style="{StaticResource Sub}"/></StackPanel>
                      <CheckBox x:Name="SetConfirm" Style="{StaticResource Switch}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource LineBrush}"/>
                    <Grid Margin="0,10">
                      <StackPanel Margin="0,0,100,0"><TextBlock Text="{DynamicResource L_set_recent}" Style="{StaticResource H2}"/><TextBlock Text="{DynamicResource L_set_recent_d}" Style="{StaticResource Sub}"/></StackPanel>
                      <CheckBox x:Name="SetRecent" Style="{StaticResource Switch}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource LineBrush}"/>
                    <Grid Margin="0,10">
                      <StackPanel Margin="0,0,100,0"><TextBlock Text="{DynamicResource L_set_smartram}" Style="{StaticResource H2}"/><TextBlock Text="{DynamicResource L_set_smartram_d}" Style="{StaticResource Sub}"/></StackPanel>
                      <CheckBox x:Name="SetSmartRam" Style="{StaticResource Switch}" HorizontalAlignment="Right"/>
                    </Grid>
                  </StackPanel>
                </Border>

                <TextBlock Text="{DynamicResource L_set_updates}" Style="{StaticResource Label}" Margin="4,0,0,8"/>
                <Border Style="{StaticResource Card}" Padding="20,6" Margin="0,0,0,18">
                  <StackPanel>
                    <Grid x:Name="AutoUpdateRow" Margin="0,10">
                      <StackPanel Margin="0,0,100,0"><TextBlock Text="{DynamicResource L_set_autoupdate}" Style="{StaticResource H2}"/><TextBlock Text="{DynamicResource L_set_autoupdate_d}" Style="{StaticResource Sub}"/></StackPanel>
                      <CheckBox x:Name="SetAutoUpdate" Style="{StaticResource Switch}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Border x:Name="AutoUpdateLine" Height="1" Background="{DynamicResource LineBrush}"/>
                    <Grid Margin="0,10">
                      <StackPanel Margin="0,0,200,0"><TextBlock x:Name="VersionLine" Style="{StaticResource H2}"/><TextBlock x:Name="UpdateStatus" Style="{StaticResource Sub}"/></StackPanel>
                      <Button x:Name="BtnCheckUpdate" Style="{StaticResource Ghost}" Content="{DynamicResource L_check_now}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Border x:Name="InstallRowLine" Height="1" Background="{DynamicResource LineBrush}"/>
                    <Grid x:Name="InstallRow" Margin="0,10">
                      <StackPanel Margin="0,0,200,0"><TextBlock x:Name="InstallTitle" Style="{StaticResource H2}"/><TextBlock x:Name="InstallDesc" Style="{StaticResource Sub}"/></StackPanel>
                      <Button x:Name="BtnInstall" Style="{StaticResource Ghost}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                  </StackPanel>
                </Border>

                <TextBlock Text="{DynamicResource L_set_data}" Style="{StaticResource Label}" Margin="4,0,0,8"/>
                <Border Style="{StaticResource Card}" Padding="20,14">
                  <WrapPanel>
                    <Button x:Name="BtnDataFolder" Content="{DynamicResource L_open_data}" Style="{StaticResource Ghost}" Margin="0,0,10,0"/>
                    <Button x:Name="BtnErrLog" Content="{DynamicResource L_error_log}" Style="{StaticResource Ghost}" Margin="0,0,10,0"/>
                    <Button x:Name="BtnResetSettings" Content="{DynamicResource L_reset_settings}" Style="{StaticResource Danger}"/>
                  </WrapPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>

          <!-- ================= ABOUT ================= -->
          <ScrollViewer x:Name="PageAbout" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,10">
              <Border CornerRadius="26" Padding="40,36" Background="{DynamicResource HeroBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Margin="0,0,0,16">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Image x:Name="AboutLogo" Width="120" Height="120" RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform><TranslateTransform/></Image.RenderTransform>
                  </Image>
                  <StackPanel Grid.Column="1" Margin="32,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="KEMAS" FontSize="52" FontWeight="Black" Foreground="{DynamicResource HeroText}"/>
                    <TextBlock Text="{DynamicResource L_tagline}" FontSize="17" Foreground="{DynamicResource HeroMuted}" Margin="0,-4,0,0"/>
                    <TextBlock x:Name="AboutVersion" FontSize="12.5" Foreground="{DynamicResource HeroMuted}" Margin="0,14,0,0"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <Button x:Name="BtnAboutUpdate" Style="{StaticResource Ghost}" Content="{DynamicResource L_check_now}"/>
                  </StackPanel>
                </Grid>
              </Border>

              <Border Style="{StaticResource Card}" Padding="36,32" Margin="0,0,0,16">
                <StackPanel>
                  <TextBlock Text="{DynamicResource L_credits}" Style="{StaticResource Label}"/>
                  <TextBlock Text="{DynamicResource L_cr_headline}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,14,0,0"/>
                  <TextBlock Text="{DynamicResource L_cr_story1}" FontSize="14" LineHeight="23" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,14,0,0"/>
                  <TextBlock Text="{DynamicResource L_cr_story2}" FontSize="14" LineHeight="23" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                  <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,26,0,22"/>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{DynamicResource L_cr_created}" Style="{StaticResource Label}"/>
                      <TextBlock Text="Amzar Syafiq" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,8,0,0"/>
                      <TextBlock Text="{DynamicResource L_cr_role}" FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                      <TextBlock Text="Ceritareka Studio" FontSize="13" Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="{DynamicResource L_cr_ack}" Style="{StaticResource Label}"/>
                      <TextBlock Text="{DynamicResource L_cr_ack_text}" FontSize="13" LineHeight="21" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>

              <Border CornerRadius="18" Padding="36,28" Margin="0,0,0,16" Background="{DynamicResource HeroBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                <StackPanel>
                  <TextBlock Text="{DynamicResource L_cr_thanks_title}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource HeroText}"/>
                  <TextBlock Text="{DynamicResource L_cr_thanks}" FontSize="14" LineHeight="23" Foreground="{DynamicResource HeroMuted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                  <TextBlock Text="— Amzar Syafiq" FontSize="14" FontStyle="Italic" Foreground="{DynamicResource HeroText}" Margin="0,14,0,0"/>
                </StackPanel>
              </Border>

              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="20" Foreground="{StaticResource CyanBrush}" HorizontalAlignment="Left"/>
                    <TextBlock Text="{DynamicResource L_ab_privacy}" Style="{StaticResource H2}" Margin="0,12,0,0"/>
                    <TextBlock Text="{DynamicResource L_ab_privacy_d}" Style="{StaticResource Sub}"/>
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7A7;" FontSize="20" Foreground="{StaticResource CyanBrush}" HorizontalAlignment="Left"/>
                    <TextBlock Text="{DynamicResource L_ab_safe}" Style="{StaticResource H2}" Margin="0,12,0,0"/>
                    <TextBlock Text="{DynamicResource L_ab_safe_d}" Style="{StaticResource Sub}"/>
                  </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="20" Foreground="{StaticResource CyanBrush}" HorizontalAlignment="Left"/>
                    <TextBlock Text="{DynamicResource L_ab_light}" Style="{StaticResource H2}" Margin="0,12,0,0"/>
                    <TextBlock Text="{DynamicResource L_ab_light_d}" Style="{StaticResource Sub}"/>
                  </StackPanel>
                </Border>
              </Grid>
              <TextBlock x:Name="CopyrightText" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,22,0,6"/>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="34,0">
          <Grid>
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,260,0"/>
            <ProgressBar x:Name="MainProgress" Width="220" Height="5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- ===== toast ===== -->
    <Border x:Name="Toast" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="236,0,0,58" CornerRadius="14"
            Background="{DynamicResource DialogBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="18,11">
      <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
      <StackPanel Orientation="Horizontal">
        <TextBlock x:Name="ToastIcon" Style="{StaticResource Icon}" Text="&#xE946;" Foreground="{StaticResource CyanBrush}" FontSize="14"/>
        <TextBlock x:Name="ToastText" Margin="10,0,0,0" FontSize="13" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>

    <!-- ===== maintenance overlay ===== -->
    <Grid x:Name="Overlay" Visibility="Collapsed" Background="{DynamicResource OverlayBrush}">
      <Border x:Name="OverlayCard" Width="880" Height="500" CornerRadius="26" Background="{DynamicResource DialogBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="30" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid x:Name="Stage" Width="350" Height="350" VerticalAlignment="Center">
            <Border CornerRadius="24" Background="#0D1020" BorderBrush="#1FFFFFFF" BorderThickness="1"/>
            <ContentControl x:Name="SceneHost"/>
            <MediaElement x:Name="AnimVideo" Width="350" Height="350" Stretch="UniformToFill" LoadedBehavior="Manual" UnloadedBehavior="Close" IsMuted="True" Visibility="Collapsed">
              <MediaElement.Clip><RectangleGeometry Rect="0,0,350,350" RadiusX="24" RadiusY="24"/></MediaElement.Clip>
            </MediaElement>
          </Grid>

          <Grid x:Name="WorkView" Grid.Column="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel>
              <TextBlock x:Name="OvTitle" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
              <TextBlock x:Name="OvSub" Style="{StaticResource Sub}"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="0,18,0,14">
              <Grid>
                <TextBlock x:Name="OvPct" Text="0%" FontSize="40" FontWeight="Bold" Foreground="{StaticResource AccentGrad}"/>
                <TextBlock x:Name="OvStep" Foreground="{DynamicResource MutedBrush}" FontSize="12.5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="120,0,0,10" TextTrimming="CharacterEllipsis"/>
              </Grid>
              <ProgressBar x:Name="OvBar" Height="10" Margin="0,6,0,0"/>
            </StackPanel>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="OvList" Margin="0,0,6,0"/>
            </ScrollViewer>
            <Button x:Name="BtnStop" Grid.Row="3" Content="{DynamicResource L_stop}" Style="{StaticResource Ghost}" HorizontalAlignment="Right" Margin="0,12,0,0" Padding="26,0"/>
          </Grid>

          <Grid x:Name="DoneView" Grid.Column="2" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
              <Canvas Width="72" Height="72">
                <Ellipse x:Name="DoneCircle" Width="64" Height="64" Canvas.Left="4" Canvas.Top="4" Stroke="{StaticResource GoodBrush}" StrokeThickness="4" StrokeDashArray="51 51" StrokeDashOffset="51"/>
                <Path x:Name="DoneCheck" Data="M 22,37 L 32,47 L 52,27" Stroke="{StaticResource GoodBrush}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeDashArray="9 9" StrokeDashOffset="9"/>
              </Canvas>
              <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="DoneTitle" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock x:Name="DoneSub" Style="{StaticResource Sub}"/>
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="0,18,0,12">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="DoneBig" Text="0 B" FontSize="44" FontWeight="Bold" Foreground="{StaticResource AccentGrad}"/>
                <TextBlock x:Name="DoneBigSub" FontSize="15" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Bottom" Margin="10,0,0,10"/>
              </StackPanel>
              <WrapPanel x:Name="DoneChips" Margin="0,8,0,0"/>
            </StackPanel>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="DoneNotes" Margin="0,0,6,0"/>
            </ScrollViewer>
            <Button x:Name="BtnFinish" Grid.Row="3" Style="{StaticResource Primary}" HorizontalAlignment="Right" Margin="0,12,0,0" Padding="34,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="13" Margin="0,0,10,0"/>
                <TextBlock Text="{DynamicResource L_finish}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <!-- ===== dialog ===== -->
    <Grid x:Name="DialogLayer" Visibility="Collapsed" Background="{DynamicResource OverlayBrush}">
      <Border x:Name="DialogCard" Width="500" CornerRadius="22" Background="{DynamicResource DialogBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="28,26"
              VerticalAlignment="Center" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
        <StackPanel>
          <Border x:Name="DialogBadge" Width="50" Height="50" CornerRadius="15" Background="{StaticResource AccentGrad}" HorizontalAlignment="Left">
            <TextBlock x:Name="DialogIcon" Style="{StaticResource Icon}" Text="&#xE946;" FontSize="20" Foreground="White" HorizontalAlignment="Center"/>
          </Border>
          <TextBlock x:Name="DialogTitle" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,16,0,0" TextWrapping="Wrap"/>
          <TextBlock x:Name="DialogMsg" FontSize="13.5" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
          <CheckBox x:Name="DialogCheck" Style="{StaticResource CB}" Margin="0,16,0,0" Visibility="Collapsed"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button x:Name="BtnDialogNo" Content="{DynamicResource L_cancel}" Style="{StaticResource Ghost}"/>
            <Button x:Name="BtnDialogYes" Style="{StaticResource Primary}" Margin="10,0,0,0"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ================= WHAT'S NEW (first launch after an update) ================= -->
    <Grid x:Name="WhatsNewLayer" Visibility="Collapsed" Background="{DynamicResource OverlayBrush}">
      <Border x:Name="WhatsNewCard" Width="560" CornerRadius="24" Background="{DynamicResource DialogBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
              VerticalAlignment="Center" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5" ClipToBounds="True">
        <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
        <StackPanel>
          <Border CornerRadius="24,24,0,0" Padding="30,28,30,24">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#557B5CFF" Offset="0"/>
                <GradientStop Color="#2222D3F5" Offset="0.7"/>
                <GradientStop Color="#0022D3F5" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Border Width="52" Height="52" CornerRadius="16" Background="{StaticResource AccentGrad}">
                  <TextBlock x:Name="WnSpark" Style="{StaticResource Icon}" Text="&#xE945;" FontSize="22" Foreground="White" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform><RotateTransform/></TextBlock.RenderTransform>
                  </TextBlock>
                </Border>
                <Border x:Name="WnVersionChip" CornerRadius="999" Padding="12,5" Margin="14,0,0,0" VerticalAlignment="Center" Background="{DynamicResource IconTile}">
                  <TextBlock x:Name="WnVersion" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource CyanBrush}"/>
                </Border>
              </StackPanel>
              <TextBlock x:Name="WnTitle" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,18,0,0" TextWrapping="Wrap"/>
              <TextBlock x:Name="WnSub" FontSize="13.5" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <StackPanel x:Name="WnList" Margin="30,6,30,0"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="30,22,30,26">
            <Button x:Name="BtnWnClose" Content="{DynamicResource L_wn_close}" Style="{StaticResource Ghost}"/>
            <Button x:Name="BtnWnTry" Content="{DynamicResource L_wn_try}" Style="{StaticResource Primary}" Margin="10,0,0,0"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
