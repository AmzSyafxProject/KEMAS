<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KEMAS" Width="1200" Height="760" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Display, Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal">
  <Window.Resources>
    <LinearGradientBrush x:Key="AccentGrad" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#3978F6" Offset="0"/>
      <GradientStop Color="#5B8DFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RingGrad" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#8B78F6" Offset="0"/>
      <GradientStop Color="#3978F6" Offset="0.5"/>
      <GradientStop Color="#43C6C0" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CyanBrush" Color="#3978F6"/>
    <SolidColorBrush x:Key="GoodBrush" Color="#27B77A"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#F4AE43"/>
    <SolidColorBrush x:Key="BadBrush" Color="#ED626B"/>

    <Style x:Key="H1" TargetType="TextBlock">
      <Setter Property="FontSize" Value="26"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
    <Style x:Key="Sub" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="Margin" Value="0,4,0,0"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    </Style>
    <Style x:Key="Big" TargetType="TextBlock">
      <Setter Property="FontSize" Value="26"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="22,18"/>
    </Style>
    <Style x:Key="Tile" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="12" Background="{DynamicResource HoverBrush}" Padding="14,14">
              <ContentPresenter HorizontalAlignment="Stretch"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource SelectBrush}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.8"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Link" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource CyanBrush}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><ContentPresenter/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Row" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="10" Background="Transparent" Padding="10,8">
              <ContentPresenter HorizontalAlignment="Stretch"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource SelectBrush}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Icon" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- navigation -->
    <Style x:Key="NavGroup" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="Opacity" Value="0.8"/>
      <Setter Property="Margin" Value="14,14,0,6"/>
    </Style>
    <Style x:Key="Nav" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="GroupName" Value="nav"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="bd" CornerRadius="10" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Padding="14,0">
              <Grid>
                <Border x:Name="bar" Width="3" Height="18" CornerRadius="2" HorizontalAlignment="Left" Margin="-14,0,0,0"
                        Background="{StaticResource AccentGrad}" Opacity="0"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock x:Name="ic" Text="{TemplateBinding Tag}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="26" VerticalAlignment="Center"/>
                  <ContentPresenter VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource NavSelBrush}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter TargetName="ic" Property="Foreground" Value="{StaticResource CyanBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- buttons -->
    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="22,0"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="10" Background="{StaticResource AccentGrad}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.9"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.75"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource Primary}">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="10" Background="{DynamicResource GhostBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource SelectBrush}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource Primary}">
      <Setter Property="Foreground" Value="{StaticResource BadBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="10" Background="#1FF2557A" BorderBrush="#55F2557A" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#33F2557A"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="IconBtn" TargetType="Button">
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="Transparent" CornerRadius="10">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="WinBtn" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- checkbox -->
    <Style x:Key="CB" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="box" Width="20" Height="20" CornerRadius="6" BorderThickness="2" BorderBrush="{DynamicResource BoxBrush}" Background="Transparent" VerticalAlignment="Center">
                <Path x:Name="mark" Data="M 3 8 L 6.5 11.5 L 13 4.5" Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="#7B5CFF"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="{StaticResource AccentGrad}"/>
                <Setter TargetName="box" Property="BorderBrush" Value="Transparent"/>
                <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- toggle switch -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Width="46" Height="26" Background="Transparent">
              <Border x:Name="track" CornerRadius="13" Background="{DynamicResource TrackBrush}" BorderBrush="{DynamicResource BoxBrush}" BorderThickness="1"/>
              <Ellipse x:Name="knob" Width="18" Height="18" HorizontalAlignment="Left" Margin="4,0,0,0" Fill="{DynamicResource MutedBrush}">
                <Ellipse.RenderTransform><TranslateTransform x:Name="kt" X="0"/></Ellipse.RenderTransform>
              </Ellipse>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="{StaticResource AccentGrad}"/>
                <Setter TargetName="track" Property="BorderBrush" Value="Transparent"/>
                <Setter TargetName="knob" Property="Fill" Value="White"/>
                <Trigger.EnterActions>
                  <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="kt" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.16"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="kt" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- pill choice -->
    <Style x:Key="Pill" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="bd" CornerRadius="10" Padding="13,6" Background="{DynamicResource GhostBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentGrad}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="8"/>
      <Setter Property="Minimum" Value="0"/>
      <Setter Property="Maximum" Value="100"/>
      <Setter Property="Foreground" Value="{StaticResource AccentGrad}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" CornerRadius="5" Background="{DynamicResource TrackBrush}"/>
              <Border x:Name="PART_Indicator" CornerRadius="5" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11" Padding="{TemplateBinding Padding}">
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="#7B5CFF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8"/>
      <Setter Property="MinWidth" Value="8"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border CornerRadius="4" Background="{DynamicResource ThumbBrush}"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="MinWidth" Value="0"/>
          <Setter Property="Height" Value="8"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Track x:Name="PART_Track">
                  <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border CornerRadius="4" Background="{DynamicResource ThumbBrush}"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                </Track>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ScrollViewer">
      <Setter Property="PanningMode" Value="VerticalOnly"/>
    </Style>

    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="RowBackground" Value="Transparent"/>
      <Setter Property="AlternatingRowBackground" Value="Transparent"/>
      <Setter Property="AlternationCount" Value="2"/>
      <Setter Property="GridLinesVisibility" Value="None"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="AutoGenerateColumns" Value="False"/>
      <Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="CanUserDeleteRows" Value="False"/>
      <Setter Property="CanUserResizeRows" Value="False"/>
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="SelectionUnit" Value="FullRow"/>
      <Setter Property="RowHeight" Value="40"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="EnableRowVirtualization" Value="True"/>
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
      <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridColumnHeader">
            <Border Background="Transparent" Padding="12,10" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="DataGridRow">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border Background="{TemplateBinding Background}" Padding="12,0">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#263978F6"/>
          <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="{DynamicResource DialogBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    </Style>
  </Window.Resources>

  <Grid x:Name="Root">
    <!-- aurora -->
    <Canvas x:Name="Aurora" IsHitTestVisible="False" ClipToBounds="True">
      <Ellipse x:Name="AuroraA" Width="660" Height="660" Canvas.Left="460" Canvas.Top="-340" Fill="{DynamicResource AuroraA}">
        <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
      </Ellipse>
      <Ellipse x:Name="AuroraB" Width="580" Height="580" Canvas.Left="780" Canvas.Top="340" Fill="{DynamicResource AuroraB}">
        <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
      </Ellipse>
      <Ellipse x:Name="AuroraC" Width="480" Height="480" Canvas.Left="140" Canvas.Top="450" Fill="{DynamicResource AuroraC}">
        <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
      </Ellipse>
    </Canvas>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="248"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- ===== sidebar ===== -->
      <Border x:Name="SideBar" Background="{DynamicResource SideBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
        <DockPanel Margin="16,18,16,16">
          <StackPanel x:Name="Brand" DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,4,0,30" Background="Transparent">
            <Image x:Name="SideLogo" Width="40" Height="40"/>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="KEMAS" FontSize="20" FontWeight="Black" Foreground="{DynamicResource TextBrush}"/>
              <TextBlock Text="{DynamicResource L_tagline}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
            </StackPanel>
          </StackPanel>

          <StackPanel DockPanel.Dock="Bottom">
            <Border x:Name="SideStatus" CornerRadius="14" Padding="12,12" Margin="0,0,0,12" Background="{DynamicResource NavSelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Cursor="Hand">
              <StackPanel Orientation="Horizontal">
                <Border Width="34" Height="34" CornerRadius="17"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#43C6C0" Offset="0"/><GradientStop Color="#3978F6" Offset="1"/></LinearGradientBrush></Border.Background><TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="14" Foreground="White" HorizontalAlignment="Center"/></Border>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                  <TextBlock x:Name="SideStatusText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                  <TextBlock x:Name="SideStatusSub" FontSize="10.5" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border x:Name="UpdateChip" Visibility="Collapsed" CornerRadius="12" Background="#1F7B5CFF" BorderBrush="#557B5CFF" BorderThickness="1" Padding="12,10" Margin="0,0,0,10" Cursor="Hand">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Foreground="{StaticResource CyanBrush}" FontSize="14"/>
                <StackPanel Margin="10,0,0,0">
                  <TextBlock Text="{DynamicResource L_update_ready}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                  <TextBlock x:Name="UpdateChipText" FontSize="11.5" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <RadioButton x:Name="NavSettings" Style="{StaticResource Nav}" Tag="&#xE713;" Content="{DynamicResource L_nav_settings}"/>
            <RadioButton x:Name="NavAbout" Style="{StaticResource Nav}" Tag="&#xE946;" Content="{DynamicResource L_nav_about}"/>
            <Border Height="1" Background="{DynamicResource LineBrush}" Margin="4,10,4,10"/>
            <TextBlock x:Name="SideVersion" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="14,0,0,0"/>
          </StackPanel>

          <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-10,0" Padding="0,0,10,0">
          <StackPanel x:Name="NavStack">
            <RadioButton x:Name="NavDash" Style="{StaticResource Nav}" Tag="&#xE80F;" Content="{DynamicResource L_nav_dash}" IsChecked="True"/>
            <TextBlock Text="{DynamicResource L_grp_clean}" Style="{StaticResource NavGroup}"/>
            <RadioButton x:Name="NavClean" Style="{StaticResource Nav}" Tag="&#xE74D;" Content="{DynamicResource L_nav_clean}"/>
            <RadioButton x:Name="NavOrg" Style="{StaticResource Nav}" Tag="&#xE8B7;" Content="{DynamicResource L_nav_org}"/>
            <TextBlock Text="{DynamicResource L_grp_boost}" Style="{StaticResource NavGroup}"/>
            <RadioButton x:Name="NavRam" Style="{StaticResource Nav}" Tag="&#xE9D9;" Content="{DynamicResource L_nav_ram}"/>
            <RadioButton x:Name="NavStartup" Style="{StaticResource Nav}" Tag="&#xE7E8;" Content="{DynamicResource L_nav_startup}"/>
            <TextBlock Text="{DynamicResource L_grp_analyze}" Style="{StaticResource NavGroup}"/>
            <RadioButton x:Name="NavDoctor" Style="{StaticResource Nav}" Tag="&#xE9D2;" Content="{DynamicResource L_nav_doctor}"/>
            <RadioButton x:Name="NavMap" Style="{StaticResource Nav}" Tag="&#xEDA2;" Content="{DynamicResource L_nav_map}"/>
            <RadioButton x:Name="NavApps" Style="{StaticResource Nav}" Tag="&#xE71D;" Content="{DynamicResource L_nav_apps}"/>
            <TextBlock Text="{DynamicResource L_grp_recover}" Style="{StaticResource NavGroup}"/>
            <RadioButton x:Name="NavRecover" Style="{StaticResource Nav}" Tag="&#xE777;" Content="{DynamicResource L_nav_recover}"/>
          </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- ===== main ===== -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="42"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar" Background="Transparent">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="34,0,0,0" IsHitTestVisible="False">
            <TextBlock Text="KEMAS" FontSize="12.5" Foreground="{DynamicResource MutedBrush}"/>
            <TextBlock Text="  /  " FontSize="12.5" Foreground="{DynamicResource MutedBrush}"/>
            <TextBlock x:Name="Crumb" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Border x:Name="BetaPill" CornerRadius="11" Height="22" Margin="0,9,10,0" Padding="2,0,10,0" Background="#26FFFFFF" VerticalAlignment="Top" ToolTip="Beta Test - official public release 25 Oct 2026">
              <StackPanel Orientation="Horizontal">
                <Border CornerRadius="9" Height="18" Padding="8,0" Background="{StaticResource AccentGrad}" VerticalAlignment="Center"><TextBlock Text="4.0" FontSize="10" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/></Border>
                <TextBlock x:Name="BetaCountdown" Margin="8,0,0,0" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <Border CornerRadius="9" Height="30" Width="260" Margin="0,6,12,0" VerticalAlignment="Top" Background="{DynamicResource HoverBrush}">
              <Grid>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="11,0,0,0"/>
                <TextBlock x:Name="SearchHint" Text="{DynamicResource L_search_hint}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="32,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Margin="28,0,8,0" VerticalContentAlignment="Center" FontSize="12" Foreground="{DynamicResource TextBrush}"/>
              </Grid>
            </Border>
            <Button x:Name="BtnTheme" Style="{StaticResource WinBtn}" Content="&#xE793;" FontSize="13" Tag="{DynamicResource HoverBrush}" ToolTip="{DynamicResource L_theme_tip}"/>
            <Button x:Name="BtnHelp" Style="{StaticResource WinBtn}" Content="&#xE897;" FontSize="13" Tag="{DynamicResource HoverBrush}" ToolTip="{DynamicResource L_help_tip}"/>
            <Button x:Name="BtnMin" ToolTip="Minimize" Style="{StaticResource WinBtn}" Content="&#xE921;" Tag="{DynamicResource HoverBrush}"/>
            <Button x:Name="BtnMax" ToolTip="Maximize" Style="{StaticResource WinBtn}" Content="&#xE922;" Tag="{DynamicResource HoverBrush}"/>
            <Button x:Name="BtnClose" ToolTip="Close" Style="{StaticResource WinBtn}" Content="&#xE8BB;" Tag="#E5484D"/>
          </StackPanel>
        </Grid>

        <Grid x:Name="Pages" Grid.Row="1" Margin="34,0,34,4">
          <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>

          <!-- ================= DASHBOARD ================= -->
          <Viewbox x:Name="PageDash" Stretch="Uniform" StretchDirection="Both" VerticalAlignment="Top" HorizontalAlignment="Center">
          <Grid Width="1240" Margin="0,0,0,6">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,12">
              <TextBlock x:Name="Greeting" Style="{StaticResource H1}"/>
              <TextBlock x:Name="DateText" Style="{StaticResource Sub}"/>
            </StackPanel>

            <Grid x:Name="DashTop" Grid.Row="1" Margin="0,0,0,12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Border Style="{StaticResource Card}" Padding="24,16">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Viewbox Width="150" Height="150" VerticalAlignment="Center">
                    <Grid Width="196" Height="196">
                      <Ellipse Width="171" Height="171" Stroke="{DynamicResource TrackBrush}" StrokeThickness="14"/>
                      <Path x:Name="RingArc" Stroke="{StaticResource RingGrad}" StrokeThickness="14" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="16" Foreground="{StaticResource GoodBrush}" HorizontalAlignment="Center" x:Name="ScoreIcon"/>
                        <TextBlock x:Name="ScoreText" Text="--" FontSize="58" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" Margin="0,-4,0,0"/>
                        <TextBlock Text="{DynamicResource L_health}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,-6,0,0"/>
                      </StackPanel>
                    </Grid>
                  </Viewbox>
                  <StackPanel Grid.Column="1" Margin="28,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="ScorePillText" FontSize="21" FontWeight="Bold" Foreground="{StaticResource GoodBrush}"/>
                    <TextBlock x:Name="ScoreTitle" Text="{DynamicResource L_checking}" FontSize="13.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <TextBlock x:Name="ScoreDesc" Text="{DynamicResource L_checking_desc}" Foreground="{DynamicResource MutedBrush}" FontSize="12.5" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    <Button x:Name="BtnSmart" Style="{StaticResource Primary}" Height="44" Padding="24,0" Margin="0,18,0,0" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5">
                      <Button.RenderTransform><ScaleTransform/></Button.RenderTransform>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource L_smart_now}" VerticalAlignment="Center"/>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72A;" FontSize="12" Margin="10,0,0,0"/>
                      </StackPanel>
                    </Button>
                    <TextBlock x:Name="LastScanText" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0"/>
                  </StackPanel>
                </Grid>
              </Border>
              <Border x:Name="AssistCard" Grid.Column="2" CornerRadius="16" Padding="22,16" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}">
                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#183978F6" Offset="0"/><GradientStop Color="#188B78F6" Offset="1"/></LinearGradientBrush></Border.Background>
                <DockPanel>
                  <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                    <Border Width="46" Height="46" CornerRadius="11"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#5B8DFF" Offset="0"/><GradientStop Color="#8B78F6" Offset="1"/></LinearGradientBrush></Border.Background><TextBlock Style="{StaticResource Icon}" Text="&#xE99A;" FontSize="20" Foreground="White" HorizontalAlignment="Center"/></Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="{DynamicResource L_assist_title}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                      <TextBlock Text="{DynamicResource L_assist_sub}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                  </StackPanel>
                  <Button x:Name="BtnAssist" DockPanel.Dock="Bottom" Style="{StaticResource Ghost}" Height="40" HorizontalAlignment="Left" Padding="18,0" Margin="0,14,0,0">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="{DynamicResource L_assist_btn}" FontWeight="SemiBold" Foreground="{StaticResource CyanBrush}"/><TextBlock Style="{StaticResource Icon}" Text="&#xE72A;" FontSize="12" Foreground="{StaticResource CyanBrush}" Margin="10,0,0,0"/></StackPanel>
                  </Button>
                  <TextBlock x:Name="AssistText" FontSize="13.5" LineHeight="20" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </DockPanel>
              </Border>
            </Grid>

            <UniformGrid x:Name="DashMetrics" Grid.Row="2" Columns="4" Margin="0,0,-14,2">
              <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,14,12">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <Border Width="40" Height="40" CornerRadius="11"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#3978F6" Offset="0"/><GradientStop Color="#5BA8FF" Offset="1"/></LinearGradientBrush></Border.Background><TextBlock Style="{StaticResource Icon}" Text="&#xE950;" FontSize="17" Foreground="White" HorizontalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="12,0,6,0" VerticalAlignment="Center">
                    <TextBlock Text="CPU" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock x:Name="CpuText" Text="-" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock x:Name="CpuSub" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <Viewbox Grid.Row="1" Grid.ColumnSpan="2" Stretch="Fill" Height="30" Margin="0,8,0,0"><Canvas Width="96" Height="44" ClipToBounds="True">
                    <Polygon x:Name="AreaCpu"><Polygon.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#405BA8FF" Offset="0"/><GradientStop Color="#005BA8FF" Offset="1"/></LinearGradientBrush></Polygon.Fill></Polygon>
                    <Polyline x:Name="SparkCpu" StrokeThickness="2" StrokeLineJoin="Round"><Polyline.Stroke><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#3978F6" Offset="0"/><GradientStop Color="#5BA8FF" Offset="1"/></LinearGradientBrush></Polyline.Stroke></Polyline>
                  </Canvas></Viewbox>
                </Grid>
              </Border>
              <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,14,12">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <Border Width="40" Height="40" CornerRadius="11"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#8B78F6" Offset="0"/><GradientStop Color="#C08BFF" Offset="1"/></LinearGradientBrush></Border.Background><TextBlock Style="{StaticResource Icon}" Text="&#xE964;" FontSize="17" Foreground="White" HorizontalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="12,0,6,0" VerticalAlignment="Center">
                    <TextBlock Text="RAM" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock x:Name="RamUsedText" Text="-" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock x:Name="RamFreeText" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <Viewbox Grid.Row="1" Grid.ColumnSpan="2" Stretch="Fill" Height="30" Margin="0,8,0,0"><Canvas Width="96" Height="44" ClipToBounds="True">
                    <Polygon x:Name="AreaRam"><Polygon.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#40C08BFF" Offset="0"/><GradientStop Color="#00C08BFF" Offset="1"/></LinearGradientBrush></Polygon.Fill></Polygon>
                    <Polyline x:Name="SparkRam" StrokeThickness="2" StrokeLineJoin="Round"><Polyline.Stroke><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#8B78F6" Offset="0"/><GradientStop Color="#C08BFF" Offset="1"/></LinearGradientBrush></Polyline.Stroke></Polyline>
                  </Canvas></Viewbox>
                </Grid>
              </Border>
              <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,14,12">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <Border Width="40" Height="40" CornerRadius="11"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F4AE43" Offset="0"/><GradientStop Color="#F7C873" Offset="1"/></LinearGradientBrush></Border.Background><TextBlock Style="{StaticResource Icon}" Text="&#xEDA2;" FontSize="17" Foreground="White" HorizontalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="12,0,6,0" VerticalAlignment="Center">
                    <TextBlock x:Name="DiskLabel" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock x:Name="DiskUsedText" Text="-" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock x:Name="DiskFreeText" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <Viewbox Grid.Row="1" Grid.ColumnSpan="2" Stretch="Fill" Height="30" Margin="0,8,0,0"><Canvas Width="96" Height="44" ClipToBounds="True">
                    <Polygon x:Name="AreaDisk"><Polygon.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#40F7C873" Offset="0"/><GradientStop Color="#00F7C873" Offset="1"/></LinearGradientBrush></Polygon.Fill></Polygon>
                    <Polyline x:Name="SparkDisk" StrokeThickness="2" StrokeLineJoin="Round"><Polyline.Stroke><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#F4AE43" Offset="0"/><GradientStop Color="#F7C873" Offset="1"/></LinearGradientBrush></Polyline.Stroke></Polyline>
                  </Canvas></Viewbox>
                </Grid>
              </Border>
              <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,14,12">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <Border Width="40" Height="40" CornerRadius="11"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#27B77A" Offset="0"/><GradientStop Color="#43C6C0" Offset="1"/></LinearGradientBrush></Border.Background><TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="17" Foreground="White" HorizontalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="12,0,6,0" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource L_tile_junk}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock x:Name="JunkText" Text="-" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock x:Name="JunkSub" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <Viewbox Grid.Row="1" Grid.ColumnSpan="2" Stretch="Fill" Height="30" Margin="0,8,0,0"><Canvas Width="96" Height="44" ClipToBounds="True">
                    <Polygon x:Name="AreaJunk"><Polygon.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#4043C6C0" Offset="0"/><GradientStop Color="#0043C6C0" Offset="1"/></LinearGradientBrush></Polygon.Fill></Polygon>
                    <Polyline x:Name="SparkJunk" StrokeThickness="2" StrokeLineJoin="Round"><Polyline.Stroke><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#27B77A" Offset="0"/><GradientStop Color="#43C6C0" Offset="1"/></LinearGradientBrush></Polyline.Stroke></Polyline>
                  </Canvas></Viewbox>
                </Grid>
              </Border>
            </UniformGrid>

            <Grid x:Name="DashBottom" Grid.Row="3" Margin="0,0,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="5*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="5*"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Border x:Name="QaCard" Style="{StaticResource Card}" Padding="20,16,12,10">
                <StackPanel>
                  <TextBlock Text="{DynamicResource L_quick_actions_t}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12"/>
                  <UniformGrid Columns="2">
                    <Button x:Name="QaClean" Style="{StaticResource Tile}" Margin="0,0,8,8">
                      <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="11"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#3978F6" Offset="0"/><GradientStop Color="#5BA8FF" Offset="1"/></LinearGradientBrush></Border.Background><TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="15" Foreground="White" HorizontalAlignment="Center"/></Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                          <TextBlock Text="{DynamicResource L_qa_clean}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{DynamicResource L_qa_clean_d}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                      </StackPanel>
                    </Button>
                    <Button x:Name="QaRam" Style="{StaticResource Tile}" Margin="0,0,8,8">
                      <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="11"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#8B78F6" Offset="0"/><GradientStop Color="#C08BFF" Offset="1"/></LinearGradientBrush></Border.Background><TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="15" Foreground="White" HorizontalAlignment="Center"/></Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                          <TextBlock Text="{DynamicResource L_qa_ram}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{DynamicResource L_qa_ram_d}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                      </StackPanel>
                    </Button>
                    <Button x:Name="QaStartup" Style="{StaticResource Tile}" Margin="0,0,8,8">
                      <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="11"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#43C6C0" Offset="0"/><GradientStop Color="#3978F6" Offset="1"/></LinearGradientBrush></Border.Background><TextBlock Style="{StaticResource Icon}" Text="&#xE7E8;" FontSize="15" Foreground="White" HorizontalAlignment="Center"/></Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                          <TextBlock Text="{DynamicResource L_nav_startup}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{DynamicResource L_qa_startup_d}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                      </StackPanel>
                    </Button>
                    <Button x:Name="QaOrg" Style="{StaticResource Tile}" Margin="0,0,8,8">
                      <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="11"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F4AE43" Offset="0"/><GradientStop Color="#ED8F5B" Offset="1"/></LinearGradientBrush></Border.Background><TextBlock Style="{StaticResource Icon}" Text="&#xEDA2;" FontSize="15" Foreground="White" HorizontalAlignment="Center"/></Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                          <TextBlock Text="{DynamicResource L_qa_map}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{DynamicResource L_qa_map_d}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                      </StackPanel>
                    </Button>
                  </UniformGrid>
                </StackPanel>
              </Border>
              <Border x:Name="StoCard" Grid.Column="2" Style="{StaticResource Card}" Padding="20,16">
                <StackPanel>
                  <TextBlock Text="{DynamicResource L_storage_ov}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                  <Grid Margin="0,14,0,0">
                    <TextBlock x:Name="OvDrive" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock x:Name="OvUsed" FontSize="12" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                  </Grid>
                  <Border CornerRadius="5" Height="10" Margin="0,10,0,14" ClipToBounds="True" Background="{DynamicResource TrackBrush}">
                    <Grid x:Name="StoBar"/>
                  </Border>
                  <WrapPanel x:Name="OvLegend"/>
                  <Button x:Name="BtnOvMap" Style="{StaticResource Link}" Content="{DynamicResource L_ov_map}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                </StackPanel>
              </Border>
              <Border x:Name="TipsCard" Grid.Column="4" Style="{StaticResource Card}" Padding="20,16">
                <DockPanel>
                  <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xEA80;" FontSize="14" Foreground="{StaticResource WarnBrush}" Margin="0,0,8,0"/><TextBlock Text="{DynamicResource L_perf_tips}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/></StackPanel>
                    <TextBlock x:Name="RoadToGo" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource CyanBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                  </Grid>
                  <Button x:Name="BtnViewAll" DockPanel.Dock="Bottom" Style="{StaticResource Link}" Content="{DynamicResource L_view_tips}" HorizontalAlignment="Right" Margin="0,6,0,0"/>
                  <StackPanel x:Name="RoadList"/>
                </DockPanel>
              </Border>
            </Grid>

            <!-- kept for the engine log and history; shown in Recovery Centre -->
            <StackPanel Visibility="Collapsed">
              <TextBlock x:Name="LastCleanText"/><TextBlock x:Name="RecentEmpty"/><StackPanel x:Name="RecentList"/>
              <TextBox x:Name="LogBox"/><Button x:Name="BtnDashScan"/>
              <Border x:Name="ScorePill"/><TextBlock x:Name="TileJunk"/><TextBlock x:Name="TileDisk"/><TextBlock x:Name="TileRam"/>
              <ProgressBar x:Name="DiskBar"/><ProgressBar x:Name="RamBar"/>
            </StackPanel>
          </Grid>
          </Viewbox>

          <!-- ================= CLEANER ================= -->
          <Grid x:Name="PageClean" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,20">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,16,0">
                <TextBlock Text="{DynamicResource L_clean_title}" Style="{StaticResource H1}"/>
                <TextBlock Text="{DynamicResource L_clean_sub}" Style="{StaticResource Sub}"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="BtnSelAll" Content="{DynamicResource L_select_all}" Style="{StaticResource Ghost}"/>
                <Button x:Name="BtnScan" Content="{DynamicResource L_scan_again}" Style="{StaticResource Ghost}" Margin="10,0,0,0"/>
                <Button x:Name="BtnDeep" Style="{StaticResource Primary}" Margin="10,0,0,0" Padding="18,0" ToolTip="{DynamicResource L_deep_tip}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="14" Foreground="White" Margin="0,0,8,0"/>
                    <TextBlock Text="{DynamicResource L_deep_btn}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
            <Grid Grid.Row="1" Grid.RowSpan="2">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}" Padding="18,4,18,4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel x:Name="CleanList" Margin="0,0,6,0"/>
                </ScrollViewer>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22,20" VerticalAlignment="Top">
                <StackPanel>
                  <TextBlock Text="{DynamicResource L_sel_label}" Style="{StaticResource Label}"/>
                  <TextBlock x:Name="SelTotal" Text="0 B" FontSize="34" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,6,0,0"/>
                  <TextBlock x:Name="SelCount" Style="{StaticResource Sub}" Margin="0,0,0,0"/>
                  <TextBlock Text="{DynamicResource L_sel_safe}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="19" Margin="0,16,0,0"/>
                  <Button x:Name="BtnClean" Content="{DynamicResource L_clean_selected}" Style="{StaticResource Primary}" Height="44" Margin="0,20,0,0"/>
                </StackPanel>
              </Border>
            </Grid>
          </Grid>

          <!-- ================= ORGANIZER ================= -->
          <Grid x:Name="PageOrg" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
